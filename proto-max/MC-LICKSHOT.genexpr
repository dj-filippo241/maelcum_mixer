// MC-LICKSHOT - lickshot in rack (dec. 179-189), modello lickshot.py.
// GENERATO da proto-max/coefficienti/genera_lickshot.py: non modificare.
// LFO CD4069 a dente di sega -> VCO CD4046 -> passa-alto 14,5 Hz -> FIRE
// -> VOLUME -> eco a due BBD senza filtri (nel giro passa-alto
// e saturazione). in1, in2 ignorati.
// out1 = out2 = uscita (1,0 = 4.3609 V); out3 = LED dell'LFO.

Param alt(71, min=0, max=100);
Param vel(50, min=0, max=100);
Param prof(67, min=0, max=100);
Param vol(100, min=0, max=100);
Param trig(0, min=0, max=1);
Param tempo(33, min=0, max=100);
Param rip(40, min=0, max=100);
Param eco(40, min=0, max=100);
History vi(4.3);
History su(0);
History fase(0);
History hpx(0);
History hpy(0);
History gx(0);
History gy(0);
History ck(0);
History hin(0);
History hout(0);
History td(7805.337600000001);
Delay dl(48000);
History s_alt(71.0);
History s_vel(50.0);
History s_prof(67.0);
History s_vol(100.0);
History s_tempo(33.0);
History s_rip(40.0);
History s_eco(40.0);
t10 = exp(-1 / (0.010 * samplerate));
s_alt = alt + t10 * (s_alt - alt);
s_vel = vel + t10 * (s_vel - vel);
s_prof = prof + t10 * (s_prof - prof);
s_vol = vol + t10 * (s_vol - vol);
s_tempo = tempo + t10 * (s_tempo - tempo);
s_rip = rip + t10 * (s_rip - rip);
s_eco = eco + t10 * (s_eco - eco);
// LFO: integratore fra le soglie del Schmitt, discesa lenta, risalita dal diodo
rl = 33000.0 + (1 - s_vel / 100) * 500000.0;
giu = 4.3 / (rl * 1e-06) / samplerate;
sup = 7818.181818181819 / samplerate;
vin = vi + su * sup - (1 - su) * giu;
hhi = su * (vin >= 6.254545454545455);
hlo = (1 - su) * (vin <= 2.3454545454545452);
vi = min(max(vin, 2.3454545454545452), 6.254545454545455);
su = su * (1 - hhi) + hlo;
// PROFONDITA (dec. 190): pot fra la rampa e VDD/2, buffer verso il VCOin
vco = 4.3 + s_prof / 100 * 2.911764705882353 * (vi - 4.3) / 1.9545454545454548;
// VCO: frequenza lineare col VCOin, f0 al centro (datasheet TI, Fig. 4)
r1 = 10000.0 * pow(11.0, 1 - s_alt / 100);
fz = 0.7 / (r1 * 1e-07);
fq = fz * max(0, vco - 1.0) / 3.3;
dt = max(fq / samplerate, 1e-9);
// onda quadra con PolyBLEP
ta = fase / dt;
tc = (fase - 1) / dt;
xq = (fase < 0.5) * 2 - 1 + (fase < dt) * (ta + ta - ta * ta - 1) + (fase > 1 - dt) * (tc * tc + tc + tc + 1);
t2 = fase + 0.5 - (fase + 0.5 >= 1);
tb = t2 / dt;
te = (t2 - 1) / dt;
xq = xq - (t2 < dt) * (tb + tb - tb * tb - 1) - (t2 > 1 - dt) * (te * te + te + te + 1);
fase = fase + fq / samplerate;
fase = fase - (fase >= 1);
khp = 1 / (1 + 91.106186954104 / samplerate);
hpy = khp * (hpy + xq - hpx);
hpx = xq;
vv = s_vol / 100;
dry = hpy * (trig > 0.5) * 0.775 * vv * vv;
// eco: due BBD in fila senza filtri (dec. 191), tempo lisciato (fionda);
// i BBD campionano e tengono al ritmo del clock
tm = 0.04096 + 0.36864 * s_tempo / 100;
td = td + (tm * samplerate - td) * (1 - exp(-1 / (0.05 * samplerate)));
ck = ck + 4096.0 / (td / samplerate) / samplerate;
tick = ck >= 1;
ck = ck - tick;
rd = dl.read(td, interp="linear");
hout = tick * rd + (1 - tick) * hout;
// giro: passa-alto e saturazione
kg = 1 / (1 + 942.4777960769379 / samplerate);
gy = kg * (gy + hout - gx);
gx = hout;
fb = 1.5 * tanh(1.1 * s_rip / 100 * gy / 1.5);
hin = tick * (dry + fb) + (1 - tick) * hin;
dl.write(hin);
ve = s_eco / 100;
out1 = (dry + ve * ve * hout) / 4.360865946243008;
out2 = out1;
out3 = min(max((vi - 2.4) / 3.854545454545455, 0), 1);
