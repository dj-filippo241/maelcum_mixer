// MC-FILTRO - prototipo Max P1 (parte 1) del filtro maelcum_mixer.
// GENERATO da proto-max/coefficienti/genera_filtro.py: non modificare.
// SVF 4 poli (Q 0,541 fissa + Q 1,307 con RES), core OTA (a') col
// tetto di 1,55 V o pulito (c-B), limitatore a diodi. Banca a 4x.

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

// guadagno a secante dell'OTA: Vs tanh(u/Vs)/u
aota(u) {
	m = max(abs(u), 0.000001);
	return 1.55112 * tanh(m / 1.55112) / m;
}

// softplus limitato (niente overflow)
spl(z) {
	return log(1 + exp(min(z, 30))) + max(z - 30, 0);
}

// conduttanza a secante del limitatore a diodi (4,7k + diodi 1N4148):
// lg conduttanza, lk ginocchio, lw morbidezza (volt)
alim(v, lg, lk, lw) {
	m = max(abs(v), 0.000001);
	return lg * lw * (spl((m - lk) / lw) - spl(-lk / lw)) / m;
}

// guadagno a secante dell'OTA della RES (voce PULITO OTA):
// partitore 1/15, Vs tanh(u/Vs)/u
ares(u) {
	m = max(abs(u), 0.000001);
	return 0.77556 * tanh(m / 0.77556) / m;
}

// tosatore dell'overdrive: 2,2k + 2+2 1N4148, tre passi di Newton
clipd(v) {
	a = abs(v);
	t = a / 1.1088e-05;
	w = min(a, 0.09063096 * log(t + sqrt(t * t + 1)));
	ex = exp(w / 0.09063096);
	f = (a - w) / 2200.0 - 2.52e-09 * (ex - 1 / ex);
	df = -1 / 2200.0 - 2.52e-09 * (ex + 1 / ex) / 0.09063096;
	w = w - f / df;
	ex = exp(w / 0.09063096);
	f = (a - w) / 2200.0 - 2.52e-09 * (ex - 1 / ex);
	df = -1 / 2200.0 - 2.52e-09 * (ex + 1 / ex) / 0.09063096;
	w = w - f / df;
	ex = exp(w / 0.09063096);
	f = (a - w) / 2200.0 - 2.52e-09 * (ex - 1 / ex);
	df = -1 / 2200.0 - 2.52e-09 * (ex + 1 / ex) / 0.09063096;
	w = w - f / df;
	return w * ((v >= 0) * 2 - 1);
}

// sezione SVF 2 poli TPT; stato in m[i..i+3] = s1, s2, hp, bp
// d = 1/Q. Varianti senza rami morti (CPU): a = core OTA
// (guadagno a secante), c = integratori lineari; 1 = col limitatore.
// Un solo valore di ritorno per funzione (regola gen~): _hp o _lp
sez_a0_hp(m, i, x, g, d) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	ab = aota(bpv);
	g1 = g * aota(peek(m, i + 2));
	g2 = g * ab;
	rr = d * ab;
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return hp;
}

sez_a0_lp(m, i, x, g, d) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	ab = aota(bpv);
	g1 = g * aota(peek(m, i + 2));
	g2 = g * ab;
	rr = d * ab;
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return lp;
}

sez_a1_hp(m, i, x, g, d) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	ab = aota(bpv);
	g1 = g * aota(peek(m, i + 2));
	g2 = g * ab;
	rr = d * ab + alim(bpv, 1.7, 0.82, 0.06);
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return hp;
}

sez_a1_lp(m, i, x, g, d) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	ab = aota(bpv);
	g1 = g * aota(peek(m, i + 2));
	g2 = g * ab;
	rr = d * ab + alim(bpv, 1.7, 0.82, 0.06);
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return lp;
}

sez_c0_hp(m, i, x, g, d) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	g1 = g;
	g2 = g;
	rr = d;
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return hp;
}

sez_c0_lp(m, i, x, g, d) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	g1 = g;
	g2 = g;
	rr = d;
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return lp;
}

sez_c1_hp(m, i, x, g, d, lk, lw, lo, qb) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	g1 = g;
	g2 = g;
	rr = d + (1 - lo) * alim(bpv, 2.13, lk, lw) + lo * (qb - d) * (1 - ares(bpv));
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return hp;
}

sez_c1_lp(m, i, x, g, d, lk, lw, lo, qb) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	bpv = peek(m, i + 3);
	g1 = g;
	g2 = g;
	rr = d + (1 - lo) * alim(bpv, 2.13, lk, lw) + lo * (qb - d) * (1 - ares(bpv));
	bp = (g1 * (x - s2) + s1) / (1 + g1 * g2 + g1 * rr);
	hp = x - s2 - (g2 + rr) * bp;
	lp = g2 * bp + s2;
	poke(m, bp + g1 * hp, i);
	poke(m, lp + g2 * bp, i + 1);
	poke(m, hp, i + 2);
	poke(m, bp, i + 3);
	return lp;
}

Param freq_hp(0.0, min=0, max=100);
Param res_hp(0.0, min=0, max=100);
Param drive_hp(0.0, min=0, max=100);
Param freq_lp(100.0, min=0, max=100);
Param res_lp(0.0, min=0, max=100);
Param drive_lp(0.0, min=0, max=100);
Param modo(1, min=0, max=2);
Param lim(0, min=0, max=2);
Param core(0, min=0, max=1);
Param pend(0, min=0, max=2);
Data st(64);
Data hb(128);
History s_freq_hp(0.0);
History s_res_hp(0.0);
History s_drive_hp(0.0);
History s_freq_lp(100.0);
History s_res_lp(0.0);
History s_drive_lp(0.0);
History s_modo(1);
History s_lim(0);
History s_core(0);
History s_pend(0);

// manopole lisciate 10 ms; MODO 1 ms (rampa, dec. 80); CORE 20 ms
t1 = exp(-1 / (0.001 * samplerate));
t10 = exp(-1 / (0.010 * samplerate));
t20 = exp(-1 / (0.020 * samplerate));
s_freq_hp = freq_hp + t10 * (s_freq_hp - freq_hp);
s_res_hp = res_hp + t10 * (s_res_hp - res_hp);
s_drive_hp = drive_hp + t10 * (s_drive_hp - drive_hp);
s_freq_lp = freq_lp + t10 * (s_freq_lp - freq_lp);
s_res_lp = res_lp + t10 * (s_res_lp - res_lp);
s_drive_lp = drive_lp + t10 * (s_drive_lp - drive_lp);
s_modo = modo + t1 * (s_modo - modo);
s_lim = lim + t20 * (s_lim - lim);
// LIMITATORE del PULITO: 2+2 o 3+3 diodi (RISULTATI-cb-4p §RES), poi OTA della RES senza diodi, 20 ms
lim_d = min(s_lim, 1);
lim_o = max(s_lim - 1, 0);
lim_k = 0.72 + 0.21000000000000008 * lim_d;
lim_w = 0.06 + 0.03 * lim_d;
s_core = core + t20 * (s_core - core);
s_pend = pend + t20 * (s_pend - pend);
w_hp = max(0, 1 - abs(s_modo));
w_off = max(0, 1 - abs(s_modo - 1));
w_lp = max(0, 1 - abs(s_modo - 2));
// si calcola solo il core che si sente (CPU: traccia su un core)
on_a = 1 - s_core > 1e-05;
on_c = s_core > 1e-05;

sr4 = samplerate * 4;
// PENDENZA: Q e frequenze delle due sezioni, scivolano in 20 ms
wp0 = max(0, 1 - abs(s_pend - 0));
wp1 = max(0, 1 - abs(s_pend - 1));
wp2 = max(0, 1 - abs(s_pend - 2));
q1i = wp0 * 1.8477457501847745 + wp1 * 1.4142271248762552 + wp2 * 1.9160758766047135;
m1 = wp0 * 1.0 + wp1 * 1.0 + wp2 * 1.4192;
q2i = wp0 * 0.765345170671973 + wp1 * 1.4142271248762552 + wp2 * 1.2414649286157666;
m2 = wp0 * 1.0 + wp1 * 1.0 + wp2 * 1.5912;
dq1 = q1i;
// sezione HP: FREQ dec. 102 (a), RES dec. 102 (b)
th = s_freq_hp / 100;
f_hp = (th < 0.05) * 10 * pow(2, th / 0.05) + (th >= 0.05) * (th <= 0.95) * 20 * pow(1000, (th - 0.05) / 0.9) + (th > 0.95) * 20000 * pow(1.75, (th - 0.95) / 0.05);
g_hp1 = tan(pi * f_hp / m1 / sr4);
g_hp2 = tan(pi * f_hp / m2 / sr4);
od_hp = pow(s_drive_hp / 100, 2.5);
tr = s_res_hp / 100;
gr = (tr <= 0.9) * (1 - tr / 0.9) + (tr > 0.9) * (-0.75 * (tr - 0.9) / 0.1);
d_hp = (gr > 0) * gr * q2i + (gr <= 0) * 1.4142135623730951 * gr;
// sezione LP: FREQ dec. 102 (a), RES dec. 102 (b)
th = s_freq_lp / 100;
f_lp = (th < 0.05) * 10 * pow(2, th / 0.05) + (th >= 0.05) * (th <= 0.95) * 20 * pow(1000, (th - 0.05) / 0.9) + (th > 0.95) * 20000 * pow(1.75, (th - 0.95) / 0.05);
g_lp1 = tan(pi * f_lp * m1 / sr4);
g_lp2 = tan(pi * f_lp * m2 / sr4);
od_lp = pow(s_drive_lp / 100, 2.5);
tr = s_res_lp / 100;
gr = (tr <= 0.9) * (1 - tr / 0.9) + (tr > 0.9) * (-0.75 * (tr - 0.9) / 0.1);
d_lp = (gr > 0) * gr * q2i + (gr <= 0) * 1.4142135623730951 * gr;

// livelli: 1,0 digitale = 4.361 V (0 dBu = -12 dBFS)
// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
L_e = ap(hb, 8, L_e, 0.3650536901969154);
L_e = ap(hb, 12, L_e, 0.5755010797915323);
L_e = ap(hb, 16, L_e, 0.7526447471286863);
L_e = ap(hb, 20, L_e, 0.8980636464339091);
L_o = ap(hb, 2, L_o, 0.07350243453590219);
L_o = ap(hb, 6, L_o, 0.25649919975582064);
L_o = ap(hb, 10, L_o, 0.47327898479453656);
L_o = ap(hb, 14, L_o, 0.6688095014357188);
L_o = ap(hb, 18, L_o, 0.8282265929955738);
L_o = ap(hb, 22, L_o, 0.9656701590349398);
L_u0 = L_e;
L_u1 = L_e;
L_u0 = ap(hb, 24, L_u0, 0.04245470986526787);
L_u0 = ap(hb, 28, L_u0, 0.39331989319033134);
L_u1 = ap(hb, 26, L_u1, 0.17073985049750015);
L_u1 = ap(hb, 30, L_u1, 0.7457135887202412);
L_u2 = L_o;
L_u3 = L_o;
L_u2 = ap(hb, 24, L_u2, 0.04245470986526787);
L_u2 = ap(hb, 28, L_u2, 0.39331989319033134);
L_u3 = ap(hb, 26, L_u3, 0.17073985049750015);
L_u3 = ap(hb, 30, L_u3, 0.7457135887202412);
xin = L_u0 * 4.360865946243008 + noise() * 0.00001;
ahph = 0;
alpl = 0;
if (on_a) {
ahph = sez_a0_hp(st, 0, xin, g_hp1, dq1);
ahph = sez_a1_hp(st, 4, ahph, g_hp2, d_hp);
alpl = sez_a0_lp(st, 8, xin, g_lp1, dq1);
alpl = sez_a1_lp(st, 12, alpl, g_lp2, d_lp);
}
chph = 0;
clpl = 0;
if (on_c) {
chph = sez_c0_hp(st, 16, xin, g_hp1, dq1);
chph = sez_c1_hp(st, 20, chph, g_hp2, d_hp, lim_k, lim_w, lim_o, q2i);
clpl = sez_c0_lp(st, 24, xin, g_lp1, dq1);
clpl = sez_c1_lp(st, 28, clpl, g_lp2, d_lp, lim_k, lim_w, lim_o, q2i);
}
ohp = (1 - s_core) * ahph + s_core * chph;
if (od_hp > 1e-09) {
ohp = ohp + od_hp * (1.171 * clipd(2 * ohp) - ohp);
}
olp = (1 - s_core) * alpl + s_core * clpl;
if (od_lp > 1e-09) {
olp = olp + od_lp * (1.171 * clipd(2 * olp) - olp);
}
L_y0 = (w_off * xin + w_hp * ohp + w_lp * olp) / 4.360865946243008;
xin = L_u1 * 4.360865946243008 + noise() * 0.00001;
ahph = 0;
alpl = 0;
if (on_a) {
ahph = sez_a0_hp(st, 0, xin, g_hp1, dq1);
ahph = sez_a1_hp(st, 4, ahph, g_hp2, d_hp);
alpl = sez_a0_lp(st, 8, xin, g_lp1, dq1);
alpl = sez_a1_lp(st, 12, alpl, g_lp2, d_lp);
}
chph = 0;
clpl = 0;
if (on_c) {
chph = sez_c0_hp(st, 16, xin, g_hp1, dq1);
chph = sez_c1_hp(st, 20, chph, g_hp2, d_hp, lim_k, lim_w, lim_o, q2i);
clpl = sez_c0_lp(st, 24, xin, g_lp1, dq1);
clpl = sez_c1_lp(st, 28, clpl, g_lp2, d_lp, lim_k, lim_w, lim_o, q2i);
}
ohp = (1 - s_core) * ahph + s_core * chph;
if (od_hp > 1e-09) {
ohp = ohp + od_hp * (1.171 * clipd(2 * ohp) - ohp);
}
olp = (1 - s_core) * alpl + s_core * clpl;
if (od_lp > 1e-09) {
olp = olp + od_lp * (1.171 * clipd(2 * olp) - olp);
}
L_y1 = (w_off * xin + w_hp * ohp + w_lp * olp) / 4.360865946243008;
xin = L_u2 * 4.360865946243008 + noise() * 0.00001;
ahph = 0;
alpl = 0;
if (on_a) {
ahph = sez_a0_hp(st, 0, xin, g_hp1, dq1);
ahph = sez_a1_hp(st, 4, ahph, g_hp2, d_hp);
alpl = sez_a0_lp(st, 8, xin, g_lp1, dq1);
alpl = sez_a1_lp(st, 12, alpl, g_lp2, d_lp);
}
chph = 0;
clpl = 0;
if (on_c) {
chph = sez_c0_hp(st, 16, xin, g_hp1, dq1);
chph = sez_c1_hp(st, 20, chph, g_hp2, d_hp, lim_k, lim_w, lim_o, q2i);
clpl = sez_c0_lp(st, 24, xin, g_lp1, dq1);
clpl = sez_c1_lp(st, 28, clpl, g_lp2, d_lp, lim_k, lim_w, lim_o, q2i);
}
ohp = (1 - s_core) * ahph + s_core * chph;
if (od_hp > 1e-09) {
ohp = ohp + od_hp * (1.171 * clipd(2 * ohp) - ohp);
}
olp = (1 - s_core) * alpl + s_core * clpl;
if (od_lp > 1e-09) {
olp = olp + od_lp * (1.171 * clipd(2 * olp) - olp);
}
L_y2 = (w_off * xin + w_hp * ohp + w_lp * olp) / 4.360865946243008;
xin = L_u3 * 4.360865946243008 + noise() * 0.00001;
ahph = 0;
alpl = 0;
if (on_a) {
ahph = sez_a0_hp(st, 0, xin, g_hp1, dq1);
ahph = sez_a1_hp(st, 4, ahph, g_hp2, d_hp);
alpl = sez_a0_lp(st, 8, xin, g_lp1, dq1);
alpl = sez_a1_lp(st, 12, alpl, g_lp2, d_lp);
}
chph = 0;
clpl = 0;
if (on_c) {
chph = sez_c0_hp(st, 16, xin, g_hp1, dq1);
chph = sez_c1_hp(st, 20, chph, g_hp2, d_hp, lim_k, lim_w, lim_o, q2i);
clpl = sez_c0_lp(st, 24, xin, g_lp1, dq1);
clpl = sez_c1_lp(st, 28, clpl, g_lp2, d_lp, lim_k, lim_w, lim_o, q2i);
}
ohp = (1 - s_core) * ahph + s_core * chph;
if (od_hp > 1e-09) {
ohp = ohp + od_hp * (1.171 * clipd(2 * ohp) - ohp);
}
olp = (1 - s_core) * alpl + s_core * clpl;
if (od_lp > 1e-09) {
olp = olp + od_lp * (1.171 * clipd(2 * olp) - olp);
}
L_y3 = (w_off * xin + w_hp * ohp + w_lp * olp) / 4.360865946243008;
if (on_a == 0) {
poke(st, 0, 0);
poke(st, 0, 1);
poke(st, 0, 2);
poke(st, 0, 3);
poke(st, 0, 4);
poke(st, 0, 5);
poke(st, 0, 6);
poke(st, 0, 7);
poke(st, 0, 8);
poke(st, 0, 9);
poke(st, 0, 10);
poke(st, 0, 11);
poke(st, 0, 12);
poke(st, 0, 13);
poke(st, 0, 14);
poke(st, 0, 15);
}
if (on_c == 0) {
poke(st, 0, 16);
poke(st, 0, 17);
poke(st, 0, 18);
poke(st, 0, 19);
poke(st, 0, 20);
poke(st, 0, 21);
poke(st, 0, 22);
poke(st, 0, 23);
poke(st, 0, 24);
poke(st, 0, 25);
poke(st, 0, 26);
poke(st, 0, 27);
poke(st, 0, 28);
poke(st, 0, 29);
poke(st, 0, 30);
poke(st, 0, 31);
}
d0 = L_y1;
d1 = L_y0;
d0 = ap(hb, 32, d0, 0.04245470986526787);
d0 = ap(hb, 36, d0, 0.39331989319033134);
d1 = ap(hb, 34, d1, 0.17073985049750015);
d1 = ap(hb, 38, d1, 0.7457135887202412);
L_v0 = 0.5 * (d0 + d1);
d0 = L_y3;
d1 = L_y2;
d0 = ap(hb, 32, d0, 0.04245470986526787);
d0 = ap(hb, 36, d0, 0.39331989319033134);
d1 = ap(hb, 34, d1, 0.17073985049750015);
d1 = ap(hb, 38, d1, 0.7457135887202412);
L_v1 = 0.5 * (d0 + d1);
