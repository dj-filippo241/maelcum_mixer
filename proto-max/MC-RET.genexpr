eq = alb * eq + (1 - alb) * op1(sa, 3, eq, glb);
eq = lgk * eq;
eq = eq + hk * svhp(sv, 2, eq, ghp, khp);
R_y0 = min(max(eq, -3.7836521927978892), 3.7836521927978892);
eq = min(max(gnl * R_u1, -3.7836521927978892), 3.7836521927978892);
eq = ala * eq + (1 - ala) * op1(sa, 2, eq, gla);
