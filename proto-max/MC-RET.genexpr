// MC-RET - prototipo Max P3 (ritorno FX, fx-module §5 e §7).
// GENERATO da proto-max/coefficienti/genera_fx.py: non modificare.
// GAIN (VCA, rail) -> EQ2 (rail) -> meter -> 4 REROUTE pre-fader.
// out1-2 al fader; out3..out10 = reroute ai bus 1-4 (L, R);
// out11 meter (1 = +24 dBu), out12 clip (latch 479 ms).

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

// polo singolo TPT, uscita passa-basso; stato in m[i]
op1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return lo;
}

// SVF 2 poli TPT, uscita passa-alto; stato in m[i], m[i+1]; k = 1/Q
svhp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fh;
}

Param gain(50, min=0, max=100);
Param low(50, min=0, max=100);
Param high(50, min=0, max=100);
Param rr1(0, min=0, max=100);
History c_rr1(0);
Param rr2(0, min=0, max=100);
History c_rr2(0);
Param rr3(0, min=0, max=100);
History c_rr3(0);
Param rr4(0, min=0, max=100);
History c_rr4(0);
History menv(0);
History mlat(0);
Data sv(4);
Data sa(4);
Data hb(128);
History s_gain(50);
History s_low(50);
History s_high(50);
t10 = exp(-1 / (0.010 * samplerate));
s_gain = gain + t10 * (s_gain - gain);
s_low = low + t10 * (s_low - low);
s_high = high + t10 * (s_high - high);
sr4 = samplerate * 4;
tg = s_gain / 100;
gnl = (tg >= 0.5) * pow(10, 2.0 * (tg - 0.5)) + (tg < 0.5) * (tg >= 0.05) * pow(10, -4.444444444444445 * (0.5 - tg)) + (tg < 0.05) * 0.19999999999999998 * tg;
// EQ2 LOW: dB voluti -> posizione x del pot (fx.low_x)
ldb = (s_low / 100 >= 0.5) * 12.0 * (s_low / 100 - 0.5) + (s_low / 100 < 0.5) * ((s_low / 100 < 0.2) * (-30.0 + 120.0 * (s_low / 100 - 0.0)) + (s_low / 100 >= 0.2) * (-6.0 + 20.0 * (s_low / 100 - 0.2)));
lgl = pow(10, ldb / 20);
lx = (32.0 - lgl) / (31.0 * (lgl + 1));
// EQ2 HIGH: posizione thh del pot (fx.high_thh)
hth = (s_high / 100 >= 0.5) * 0.5 * pow(10, 0.6 * (s_high / 100 - 0.5)) + (s_high / 100 < 0.5) * (s_high / 100 >= 0.3) * 0.5 * pow(10, -3.75 * (0.5 - s_high / 100)) + (s_high / 100 < 0.3) * 0.2963799016731538 * s_high / 100;
lra = 31000.0 * lx + 0.001;
lrb = 31000.0 * (1 - lx) + 0.001;
ala = 1000.0 / (1000.0 + lrb);
gla = 1 / (2 * sr4 * lrb * 5.6e-08);
alb = (1000.0 + lra) / 1000.0;
glb = (1000.0 + lra) / (2 * sr4 * 1000.0 * lra * 5.6e-08);
lgk = (1000.0 + lrb) / (1000.0 + lra);
hr1 = 10000.0 * hth + 0.001;
hr2 = 10000.0 * (1 - hth) + 0.001;
hk = (1 / hr2 - 1 / hr1) / (1 / hr1 + 1 / hr2 + 2.004008016032064e-05);
ghp = tan(13827.674747047453 / sr4);
khp = 2.892749557082327;
// REROUTE: law a tratti della SPEC §7, CV lisciato 1 ms
ccr = exp(-1 / (0.001 * samplerate));
q_rr1 = (rr1 / 100 < 0.2) * (-100.0 + 300.0 * (rr1 / 100 - 0.0)) + (rr1 / 100 >= 0.2) * (rr1 / 100 < 0.45) * (-40.0 + 80.0 * (rr1 / 100 - 0.2)) + (rr1 / 100 >= 0.45) * (rr1 / 100 < 0.7) * (-20.0 + 40.00000000000001 * (rr1 / 100 - 0.45)) + (rr1 / 100 >= 0.7) * (rr1 / 100 < 0.85) * (-10.0 + 39.99999999999999 * (rr1 / 100 - 0.7)) + (rr1 / 100 >= 0.85) * (rr1 / 100 < 0.95) * (-4.0 + 30.000000000000007 * (rr1 / 100 - 0.85)) + (rr1 / 100 >= 0.95) * (-1.0 + 19.999999999999982 * (rr1 / 100 - 0.95));
l_rr1 = pow(10, q_rr1 / 20);
c_rr1 = l_rr1 + ccr * (c_rr1 - l_rr1);
q_rr2 = (rr2 / 100 < 0.2) * (-100.0 + 300.0 * (rr2 / 100 - 0.0)) + (rr2 / 100 >= 0.2) * (rr2 / 100 < 0.45) * (-40.0 + 80.0 * (rr2 / 100 - 0.2)) + (rr2 / 100 >= 0.45) * (rr2 / 100 < 0.7) * (-20.0 + 40.00000000000001 * (rr2 / 100 - 0.45)) + (rr2 / 100 >= 0.7) * (rr2 / 100 < 0.85) * (-10.0 + 39.99999999999999 * (rr2 / 100 - 0.7)) + (rr2 / 100 >= 0.85) * (rr2 / 100 < 0.95) * (-4.0 + 30.000000000000007 * (rr2 / 100 - 0.85)) + (rr2 / 100 >= 0.95) * (-1.0 + 19.999999999999982 * (rr2 / 100 - 0.95));
l_rr2 = pow(10, q_rr2 / 20);
c_rr2 = l_rr2 + ccr * (c_rr2 - l_rr2);
q_rr3 = (rr3 / 100 < 0.2) * (-100.0 + 300.0 * (rr3 / 100 - 0.0)) + (rr3 / 100 >= 0.2) * (rr3 / 100 < 0.45) * (-40.0 + 80.0 * (rr3 / 100 - 0.2)) + (rr3 / 100 >= 0.45) * (rr3 / 100 < 0.7) * (-20.0 + 40.00000000000001 * (rr3 / 100 - 0.45)) + (rr3 / 100 >= 0.7) * (rr3 / 100 < 0.85) * (-10.0 + 39.99999999999999 * (rr3 / 100 - 0.7)) + (rr3 / 100 >= 0.85) * (rr3 / 100 < 0.95) * (-4.0 + 30.000000000000007 * (rr3 / 100 - 0.85)) + (rr3 / 100 >= 0.95) * (-1.0 + 19.999999999999982 * (rr3 / 100 - 0.95));
l_rr3 = pow(10, q_rr3 / 20);
c_rr3 = l_rr3 + ccr * (c_rr3 - l_rr3);
q_rr4 = (rr4 / 100 < 0.2) * (-100.0 + 300.0 * (rr4 / 100 - 0.0)) + (rr4 / 100 >= 0.2) * (rr4 / 100 < 0.45) * (-40.0 + 80.0 * (rr4 / 100 - 0.2)) + (rr4 / 100 >= 0.45) * (rr4 / 100 < 0.7) * (-20.0 + 40.00000000000001 * (rr4 / 100 - 0.45)) + (rr4 / 100 >= 0.7) * (rr4 / 100 < 0.85) * (-10.0 + 39.99999999999999 * (rr4 / 100 - 0.7)) + (rr4 / 100 >= 0.85) * (rr4 / 100 < 0.95) * (-4.0 + 30.000000000000007 * (rr4 / 100 - 0.85)) + (rr4 / 100 >= 0.95) * (-1.0 + 19.999999999999982 * (rr4 / 100 - 0.95));
l_rr4 = pow(10, q_rr4 / 20);
c_rr4 = l_rr4 + ccr * (c_rr4 - l_rr4);
// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
