L_u2 = ap(hb, 28, L_u2, 0.39331989319033134);
L_u3 = ap(hb, 26, L_u3, 0.17073985049750015);
L_u3 = ap(hb, 30, L_u3, 0.7457135887202412);
eq = min(max(gnl * L_u0, -3.7836521927978892), 3.7836521927978892);
eq = ala * eq + (1 - ala) * op1(sa, 0, eq, gla);
eq = alb * eq + (1 - alb) * op1(sa, 1, eq, glb);
eq = lgk * eq;
eq = eq + hk * svhp(sv, 0, eq, ghp, khp);
L_y0 = min(max(eq, -3.7836521927978892), 3.7836521927978892);
eq = min(max(gnl * L_u1, -3.7836521927978892), 3.7836521927978892);
eq = ala * eq + (1 - ala) * op1(sa, 0, eq, gla);
eq = alb * eq + (1 - alb) * op1(sa, 1, eq, glb);
eq = lgk * eq;
eq = eq + hk * svhp(sv, 0, eq, ghp, khp);
L_y1 = min(max(eq, -3.7836521927978892), 3.7836521927978892);
eq = min(max(gnl * L_u2, -3.7836521927978892), 3.7836521927978892);
eq = ala * eq + (1 - ala) * op1(sa, 0, eq, gla);
eq = alb * eq + (1 - alb) * op1(sa, 1, eq, glb);
eq = lgk * eq;
eq = eq + hk * svhp(sv, 0, eq, ghp, khp);
L_y2 = min(max(eq, -3.7836521927978892), 3.7836521927978892);
eq = min(max(gnl * L_u3, -3.7836521927978892), 3.7836521927978892);
eq = ala * eq + (1 - ala) * op1(sa, 0, eq, gla);
eq = alb * eq + (1 - alb) * op1(sa, 1, eq, glb);
eq = lgk * eq;
eq = eq + hk * svhp(sv, 0, eq, ghp, khp);
L_y3 = min(max(eq, -3.7836521927978892), 3.7836521927978892);
d0 = L_y1;
d1 = L_y0;
d0 = ap(hb, 32, d0, 0.04245470986526787);
d0 = ap(hb, 36, d0, 0.39331989319033134);
d1 = ap(hb, 34, d1, 0.17073985049750015);
