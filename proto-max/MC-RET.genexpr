// meter del ritorno: una barra, mono centrato (sistema-metering §1)
mcr = exp(-1 / (0.3 * samplerate));
ma = max(abs(L_w), abs(R_w)) * 4.360865946243008;
menv = max(ma, mcr * menv);
mlat = (ma >= 15.472936263797646) * 0.479 + (ma < 15.472936263797646) * max(mlat - 1 / samplerate, 0);
out1 = L_w;
