// MC-5WAY - prototipo Max P2 del 5-way maelcum_mixer.
// GENERATO da proto-max/coefficienti/genera_5way.py: non modificare.
// Banca LR4 allineata in fase (5 vie, kill netti), 5 celle a campana,
// GROWL e NASTRO in parallelo al pulito. Tutto a 4x.

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

// SVF 2 poli TPT lineare, uscita LP; stato in m[i], m[i+1]; k = 1/Q
svlp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fl;
}

// SVF 2 poli TPT lineare, uscita BP; stato in m[i], m[i+1]; k = 1/Q
svbp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fb;
}

// SVF 2 poli TPT lineare, uscita HP; stato in m[i], m[i+1]; k = 1/Q
svhp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fh;
}

// passa-alto del 1o ordine TPT (condensatore di accoppiamento)
hp1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return x - lo;
}

// clipper del GROWL: 10k in, 22k || (1 diodo + 2,2k) || (3 diodi +
// 2,2k); Newton sulla tensione dei diodi del ramo che conduce
clipg(low) {
	ii = low / 10000.0;
	pos = ii >= 0;
	a = abs(ii);
	rr = pos * 2200.568 + (1 - pos) * 2201.704;
	nv = pos * 0.04531548 + (1 - pos) * 0.13594644;
	vd = nv * log(1 + a / 2.52e-09);
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	id = 2.52e-09 * (exp(vd / nv) - 1);
	return 47000.0 * (a - id) * (pos * 2 - 1);
}

// GROWL A BANDE, clipper del basso: Rin variabile (spinta), Rf 47000, 1 / 3 diodi con 470
clipbl(cbx, cbrin) {
	cbi = cbx / cbrin;
	cbp = cbi >= 0;
	cba = abs(cbi);
	cbr = cbp * 470.568 + (1 - cbp) * 471.704;
	cbn = cbp * 0.04531548 + (1 - cbp) * 0.13594644;
	cbd = cbn * log(1 + cba / 2.52e-09);
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 47000.0) + cbd / 47000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 47000.0) + 1 / 47000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 47000.0) + cbd / 47000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 47000.0) + 1 / 47000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 47000.0) + cbd / 47000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 47000.0) + 1 / 47000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 47000.0) + cbd / 47000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 47000.0) + 1 / 47000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 47000.0) + cbd / 47000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 47000.0) + 1 / 47000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 47000.0) + cbd / 47000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 47000.0) + 1 / 47000.0;
	cbd = cbd - cbf / cbg;
	cbq = 2.52e-09 * (exp(cbd / cbn) - 1);
	return 47000.0 * (cba - cbq) * (cbp * 2 - 1);
}

// GROWL A BANDE, clipper del medio: Rin variabile (spinta), Rf 10000, 3 / 3 diodi con 4700
clipbm(cbx, cbrin) {
	cbi = cbx / cbrin;
	cbp = cbi >= 0;
	cba = abs(cbi);
	cbr = cbp * 4701.704 + (1 - cbp) * 4701.704;
	cbn = cbp * 0.13594644 + (1 - cbp) * 0.13594644;
	cbd = cbn * log(1 + cba / 2.52e-09);
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 10000.0) + cbd / 10000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 10000.0) + 1 / 10000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 10000.0) + cbd / 10000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 10000.0) + 1 / 10000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 10000.0) + cbd / 10000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 10000.0) + 1 / 10000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 10000.0) + cbd / 10000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 10000.0) + 1 / 10000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 10000.0) + cbd / 10000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 10000.0) + 1 / 10000.0;
	cbd = cbd - cbf / cbg;
	cbe = exp(cbd / cbn);
	cbf = 2.52e-09 * (cbe - 1) * (1 + cbr / 10000.0) + cbd / 10000.0 - cba;
	cbg = 2.52e-09 * cbe / cbn * (1 + cbr / 10000.0) + 1 / 10000.0;
	cbd = cbd - cbf / cbg;
	cbq = 2.52e-09 * (exp(cbd / cbn) - 1);
	return 10000.0 * (cba - cbq) * (cbp * 2 - 1);
}

// polo singolo TPT, uscita passa-basso; stato in m[i]
op1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return lo;
}

// clipper dell'EXCITER: 10k in, 100k || (1 diodo + 1k) || (2 diodi + 1k)
clipe(h) {
	ii = h / 10000.0;
	pos = ii >= 0;
	a = abs(ii);
	rr = pos * 1000.568 + (1 - pos) * 1001.136;
	nv = pos * 0.04531548 + (1 - pos) * 0.09063096;
	vd = nv * log(1 + a / 2.52e-09);
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	id = 2.52e-09 * (exp(vd / nv) - 1);
	return 100000.0 * (a - id) * (pos * 2 - 1);
}

// CLASSE A: un passo di Newton su Vbe (Gummel-Poon ridotto, 2N3904);
// m[i] = Vc stimata, m[i+1] = Ic
bstep(m, i, vbe, vb, ve2, vth, rp) {
	ex = exp(vbe / 0.025865);
	q1 = 1 / (1 - (vb - peek(m, i)) / 74.03);
	q2 = 6.734e-15 * (ex - 1) / 0.06678;
	sq = sqrt(1 + 4 * q2);
	qb = 0.5 * q1 * (1 + sq);
	ic = 6.734e-15 * (ex - 1) / qb;
	ie = ic * 1.0024015369836696;
	f = vbe + 100.0 * ie + ve2 - vb;
	df = 1 + 100.0 * ie / 0.025865 / sq;
	poke(m, max(vth - rp * ic, ve2 + 100.0 * ie + 0.15), i);
	poke(m, ic, i + 1);
	return min(max(vbe - f / df, 0.3), 0.9);
}

// NASTRO LIBERO: gate dietro 10k, diodo gate-source verso gvs;
// Newton dall'alto
gatev(gin, gvs) {
	gvg = gvs + 0.025865 * log(1 + max(gin - gvs, 0) / 1e-10);
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	return gvg;
}

// un passo di Newton sulla corrente del JFET (Shichman-Hodges,
// saturazione o triodo); drain su Rd e sul sommatore (vc)
jstep(vg, vs2, vc, idd) {
	vd = 1455.0392860607237 * (0.012 + vc / 48543.68932038835 - idd);
	vs = vs2 + 150.0 * idd;
	vov = max(vg - vs - (-3.0), 0);
	vds = vd - vs;
	sat = vds >= vov;
	cl = 1 + 0.006 * vds;
	q = vds * (2 * vov - vds);
	i = sat * 0.005 * vov * vov * cl + (1 - sat) * 0.005 * q * cl;
	dgs = sat * 0.01 * vov * cl + (1 - sat) * 0.01 * vds * cl;
	dds = sat * 3e-05 * vov * vov + (1 - sat) * 0.005 * ((2 * vov - 2 * vds) * cl + q * 0.006);
	df = 1 + dgs * 150.0 + dds * (1605.0392860607237);
	return max(idd - (idd - i) / df, 0);
}

Param k_sub(0, min=0, max=1);
Param k_kick(0, min=0, max=1);
Param k_mid(0, min=0, max=1);
Param k_high(0, min=0, max=1);
Param k_super(0, min=0, max=1);
Param g_1(50, min=0, max=100);
Param g_2(50, min=0, max=100);
Param g_3(50, min=0, max=100);
Param g_4(50, min=0, max=100);
Param g_5(50, min=0, max=100);
Param p_1(50, min=0, max=100);
Param p_2(50, min=0, max=100);
Param p_3(50, min=0, max=100);
Param p_4(50, min=0, max=100);
Param p_5(50, min=0, max=100);
Param w_1(50, min=0, max=100);
Param w_2(50, min=0, max=100);
Param w_3(50, min=0, max=100);
Param w_4(50, min=0, max=100);
Param w_5(50, min=0, max=100);
Param growl(0, min=0, max=100);
Param nastro(0, min=0, max=100);
Param xo(0, min=0, max=6);
Param gv(0, min=0, max=1);
Param nver(0, min=0, max=6);
Data sv(128);
Data sa(80);
Data zk(30);  // kill allo zero: per lato e via stato, campione prima, conteggio
Data hb(128);
History s_g_1(50);
History s_g_2(50);
History s_g_3(50);
History s_g_4(50);
History s_g_5(50);
History s_p_1(50);
History s_p_2(50);
History s_p_3(50);
History s_p_4(50);
History s_p_5(50);
History s_w_1(50);
History s_w_2(50);
History s_w_3(50);
History s_w_4(50);
History s_w_5(50);
History s_growl(50);
History s_nastro(0);
History s_xo(0);
History s_gv(50);
History s_nver(0);

// manopole lisciate 10 ms (WIDTH compreso); CROSSOVER 20 ms; KILL netti
t1 = exp(-1 / (0.001 * samplerate));
t10 = exp(-1 / (0.010 * samplerate));
t20 = exp(-1 / (0.020 * samplerate));
s_g_1 = g_1 + t10 * (s_g_1 - g_1);
s_g_2 = g_2 + t10 * (s_g_2 - g_2);
s_g_3 = g_3 + t10 * (s_g_3 - g_3);
s_g_4 = g_4 + t10 * (s_g_4 - g_4);
s_g_5 = g_5 + t10 * (s_g_5 - g_5);
s_p_1 = p_1 + t10 * (s_p_1 - p_1);
s_p_2 = p_2 + t10 * (s_p_2 - p_2);
s_p_3 = p_3 + t10 * (s_p_3 - p_3);
s_p_4 = p_4 + t10 * (s_p_4 - p_4);
s_p_5 = p_5 + t10 * (s_p_5 - p_5);
s_w_1 = w_1 + t1 * (s_w_1 - w_1);
s_w_2 = w_2 + t1 * (s_w_2 - w_2);
s_w_3 = w_3 + t1 * (s_w_3 - w_3);
s_w_4 = w_4 + t1 * (s_w_4 - w_4);
s_w_5 = w_5 + t1 * (s_w_5 - w_5);
s_growl = growl + t10 * (s_growl - growl);
s_nastro = nastro + t10 * (s_nastro - nastro);
s_xo = xo + t20 * (s_xo - xo);
s_gv = gv + t20 * (s_gv - gv);
s_nver = nver + t20 * (s_nver - nver);
sr4 = samplerate * 4;

// CROSSOVER: le 7 varianti di B3, frequenze che scivolano in 20 ms
wx0 = max(0, 1 - abs(s_xo - 0));
wx1 = max(0, 1 - abs(s_xo - 1));
wx2 = max(0, 1 - abs(s_xo - 2));
wx3 = max(0, 1 - abs(s_xo - 3));
wx4 = max(0, 1 - abs(s_xo - 4));
wx5 = max(0, 1 - abs(s_xo - 5));
wx6 = max(0, 1 - abs(s_xo - 6));
gx0 = tan(pi * (wx0 * 90.0 + wx1 * 80.0 + wx2 * 75.0 + wx3 * 80.0 + wx4 * 80.0 + wx5 * 70.0 + wx6 * 60.0) / sr4);
gx1 = tan(pi * (wx0 * 350.0 + wx1 * 200.0 + wx2 * 190.0 + wx3 * 220.0 + wx4 * 170.0 + wx5 * 220.0 + wx6 * 250.0) / sr4);
gx2 = tan(pi * (wx0 * 1200.0 + wx1 * 1200.0 + wx2 * 2200.0 + wx3 * 1500.0 + wx4 * 1200.0 + wx5 * 1200.0 + wx6 * 1200.0) / sr4);
gx3 = tan(pi * (wx0 * 3500.0 + wx1 * 6000.0 + wx2 * 8000.0 + wx3 * 7000.0 + wx4 * 6000.0 + wx5 * 8000.0 + wx6 * 8000.0) / sr4);

// KILL: 1 = via aperta (interruttore, dec. 88). La levetta scatta al
// primo passaggio per lo zero della via, o dopo 20 ms (dec. 164)
a0 = 1 - k_sub;
a1 = 1 - k_kick;
a2 = 1 - k_mid;
a3 = 1 - k_high;
a4 = 1 - k_super;
ztm = 0.02 * sr4;

// celle EQ: GAIN (famiglia eq-serie §10), POSITION esponenziale,
// WIDTH continuo Q3...Q0,3, taper log 20 % (fw.q_width; dec. 117, 129)
th = s_g_1 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b1 = gl - 1;
ge1 = tan(pi * 20.0 * pow(6.0, s_p_1 / 100) / sr4);
tw = s_w_1 / 100;
aw = (tw <= 0.5) * 0.4 * tw + (tw > 0.5) * (0.2 + 1.6 * (tw - 0.5));
ke1 = (0.1 + 0.9 * aw) / 0.3;
th = s_g_2 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b2 = gl - 1;
ge2 = tan(pi * 80.0 * pow(5.0, s_p_2 / 100) / sr4);
tw = s_w_2 / 100;
aw = (tw <= 0.5) * 0.4 * tw + (tw > 0.5) * (0.2 + 1.6 * (tw - 0.5));
ke2 = (0.1 + 0.9 * aw) / 0.3;
th = s_g_3 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b3 = gl - 1;
ge3 = tan(pi * 250.0 * pow(6.0, s_p_3 / 100) / sr4);
tw = s_w_3 / 100;
aw = (tw <= 0.5) * 0.4 * tw + (tw > 0.5) * (0.2 + 1.6 * (tw - 0.5));
ke3 = (0.1 + 0.9 * aw) / 0.3;
th = s_g_4 / 100;
gl = (th >= 0.5) * pow(10, 0.6 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b4 = gl - 1;
ge4 = tan(pi * 800.0 * pow(6.25, s_p_4 / 100) / sr4);
tw = s_w_4 / 100;
aw = (tw <= 0.5) * 0.4 * tw + (tw > 0.5) * (0.2 + 1.6 * (tw - 0.5));
ke4 = (0.1 + 0.9 * aw) / 0.3;
th = s_g_5 / 100;
gl = (th >= 0.5) * pow(10, 0.45 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b5 = gl - 1;
ge5 = tan(pi * 3000.0 * pow(6.666666666666667, s_p_5 / 100) / sr4);
tw = s_w_5 / 100;
aw = (tw <= 0.5) * 0.4 * tw + (tw > 0.5) * (0.2 + 1.6 * (tw - 0.5));
ke5 = (0.1 + 0.9 * aw) / 0.3;
// GROWL: curva lenta, mg = t^1.5
mg = pow(s_growl / 100, 1.5);
tn = s_nastro / 100;
mt = 0.85 * ((tn <= 0.5) * 0.5 * tn / 0.5 + (tn > 0.5) * (0.5 + 0.5 * (tn - 0.5) / 0.5));
// NASTRO LIBERO: spinta 0 -> +12 dB con la manopola
gnl = pow(10, 0.6 * tn);
// NASTRO A BANDE: manopola a curva inversa, tb = 1 - (1 - tn)^2.5
tb = 1 - pow(1 - tn, 2.5);
mtb = 0.85 * ((tb <= 0.5) * 0.5 * tb / 0.5 + (tb > 0.5) * (0.5 + 0.5 * (tb - 0.5) / 0.5));
gnb = pow(10, 0.6 * tb);
