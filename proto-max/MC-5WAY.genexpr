// MC-5WAY - prototipo Max P2 del 5-way maelcum_mixer.
// GENERATO da proto-max/coefficienti/genera_5way.py: non modificare.
// Banca LR4 allineata in fase (5 vie, kill netti), 5 celle a campana,
// GROWL e NASTRO in parallelo al pulito. Tutto a 4x.

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

// SVF 2 poli TPT lineare; stato in m[i], m[i+1]; k = 1/Q
svf(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	hp = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	bp = g * hp + s1;
	lp = g * bp + s2;
	poke(m, g * hp + bp, i);
	poke(m, g * bp + lp, i + 1);
	return lp, bp, hp;
}

// passa-alto del 1o ordine TPT (condensatore di accoppiamento)
hp1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return x - lo;
}

// clipper del GROWL: 10k in, 22k || (1 diodo + 2,2k) || (3 diodi +
// 2,2k); Newton sulla tensione dei diodi del ramo che conduce
clipg(low) {
	ii = low / 10000.0;
	pos = ii >= 0;
	a = abs(ii);
	rr = pos * 2200.568 + (1 - pos) * 2201.704;
	nv = pos * 0.04531548 + (1 - pos) * 0.13594644;
	vd = nv * log(1 + a / 2.52e-09);
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 22000.0) + vd / 22000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 22000.0) + 1 / 22000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 22000.0) + vd / 22000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 22000.0) + 1 / 22000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 22000.0) + vd / 22000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 22000.0) + 1 / 22000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 22000.0) + vd / 22000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 22000.0) + 1 / 22000.0;
	vd = vd - f / df;
	id = 2.52e-09 * (exp(vd / nv) - 1);
	return 22000.0 * (a - id) * (pos * 2 - 1);
}

// un passo di Newton sulla corrente del JFET (Shichman-Hodges,
// saturazione o triodo); drain su Rd e sul sommatore (vc)
jstep(vg, vs2, vc, idd) {
	vd = 1455.0392860607237 * (0.012 + vc / 48543.68932038835 - idd);
	vs = vs2 + 150.0 * idd;
	vov = max(vg - vs - (-3.0), 0);
	vds = vd - vs;
	sat = vds >= vov;
	cl = 1 + 0.006 * vds;
	q = vds * (2 * vov - vds);
	i = sat * 0.005 * vov * vov * cl + (1 - sat) * 0.005 * q * cl;
	dgs = sat * 0.01 * vov * cl + (1 - sat) * 0.01 * vds * cl;
	dds = sat * 3e-05 * vov * vov + (1 - sat) * 0.005 * ((2 * vov - 2 * vds) * cl + q * 0.006);
	df = 1 + dgs * 150.0 + dds * (1605.0392860607237);
	return max(idd - (idd - i) / df, 0);
}

Param k_sub(0, min=0, max=1);
Param k_kick(0, min=0, max=1);
Param k_mid(0, min=0, max=1);
Param k_high(0, min=0, max=1);
Param k_super(0, min=0, max=1);
Param g_1(50, min=0, max=100);
Param g_2(50, min=0, max=100);
Param g_3(50, min=0, max=100);
Param g_4(50, min=0, max=100);
Param g_5(50, min=0, max=100);
Param p_1(50, min=0, max=100);
Param p_2(50, min=0, max=100);
Param p_3(50, min=0, max=100);
Param p_4(50, min=0, max=100);
Param p_5(50, min=0, max=100);
Param w_1(1, min=0, max=2);
Param w_2(1, min=0, max=2);
Param w_3(1, min=0, max=2);
Param w_4(1, min=0, max=2);
Param w_5(1, min=0, max=2);
Param growl(0, min=0, max=100);
Param nastro(0, min=0, max=100);
Param xo(0, min=0, max=3);
Data sv(112);
Data sa(8);
Data hb(128);
History s_g_1(50);
History s_g_2(50);
History s_g_3(50);
History s_g_4(50);
History s_g_5(50);
History s_p_1(50);
History s_p_2(50);
History s_p_3(50);
History s_p_4(50);
History s_p_5(50);
History s_w_1(1);
History s_w_2(1);
History s_w_3(1);
History s_w_4(1);
History s_w_5(1);
History s_growl(50);
History s_nastro(0);
History s_xo(0);

// manopole lisciate 10 ms; WIDTH 1 ms; CROSSOVER 20 ms; KILL netti
t1 = exp(-1 / (0.001 * samplerate));
t10 = exp(-1 / (0.010 * samplerate));
t20 = exp(-1 / (0.020 * samplerate));
s_g_1 = g_1 + t10 * (s_g_1 - g_1);
s_g_2 = g_2 + t10 * (s_g_2 - g_2);
s_g_3 = g_3 + t10 * (s_g_3 - g_3);
s_g_4 = g_4 + t10 * (s_g_4 - g_4);
s_g_5 = g_5 + t10 * (s_g_5 - g_5);
s_p_1 = p_1 + t10 * (s_p_1 - p_1);
s_p_2 = p_2 + t10 * (s_p_2 - p_2);
s_p_3 = p_3 + t10 * (s_p_3 - p_3);
s_p_4 = p_4 + t10 * (s_p_4 - p_4);
s_p_5 = p_5 + t10 * (s_p_5 - p_5);
s_w_1 = w_1 + t1 * (s_w_1 - w_1);
s_w_2 = w_2 + t1 * (s_w_2 - w_2);
s_w_3 = w_3 + t1 * (s_w_3 - w_3);
s_w_4 = w_4 + t1 * (s_w_4 - w_4);
s_w_5 = w_5 + t1 * (s_w_5 - w_5);
s_growl = growl + t10 * (s_growl - growl);
s_nastro = nastro + t10 * (s_nastro - nastro);
s_xo = xo + t20 * (s_xo - xo);
sr4 = samplerate * 4;

// CROSSOVER: le 4 varianti di B3, frequenze che scivolano in 20 ms
wx0 = max(0, 1 - abs(s_xo - 0));
wx1 = max(0, 1 - abs(s_xo - 1));
wx2 = max(0, 1 - abs(s_xo - 2));
wx3 = max(0, 1 - abs(s_xo - 3));
gx0 = tan(pi * (wx0 * 90.0 + wx1 * 80.0 + wx2 * 75.0 + wx3 * 80.0) / sr4);
gx1 = tan(pi * (wx0 * 350.0 + wx1 * 200.0 + wx2 * 190.0 + wx3 * 220.0) / sr4);
gx2 = tan(pi * (wx0 * 1200.0 + wx1 * 1200.0 + wx2 * 2200.0 + wx3 * 1500.0) / sr4);
gx3 = tan(pi * (wx0 * 3500.0 + wx1 * 6000.0 + wx2 * 8000.0 + wx3 * 7000.0) / sr4);

// KILL: 1 = via aperta (interruttore, taglio netto: dec. 88)
a0 = 1 - k_sub;
a1 = 1 - k_kick;
a2 = 1 - k_mid;
a3 = 1 - k_high;
a4 = 1 - k_super;

// celle EQ: GAIN (famiglia eq-serie §10), POSITION esponenziale,
// WIDTH Q 3 / 1 / 0,5
th = s_g_1 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b1 = gl - 1;
ge1 = tan(pi * 20.0 * pow(6.0, s_p_1 / 100) / sr4);
ke1 = max(0, 1 - abs(s_w_1)) * 0.3333333333333333 + max(0, 1 - abs(s_w_1 - 1)) * 1.0 + max(0, 1 - abs(s_w_1 - 2)) * 2.0;
th = s_g_2 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b2 = gl - 1;
ge2 = tan(pi * 80.0 * pow(5.0, s_p_2 / 100) / sr4);
ke2 = max(0, 1 - abs(s_w_2)) * 0.3333333333333333 + max(0, 1 - abs(s_w_2 - 1)) * 1.0 + max(0, 1 - abs(s_w_2 - 2)) * 2.0;
th = s_g_3 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b3 = gl - 1;
ge3 = tan(pi * 250.0 * pow(6.0, s_p_3 / 100) / sr4);
ke3 = max(0, 1 - abs(s_w_3)) * 0.3333333333333333 + max(0, 1 - abs(s_w_3 - 1)) * 1.0 + max(0, 1 - abs(s_w_3 - 2)) * 2.0;
th = s_g_4 / 100;
gl = (th >= 0.5) * pow(10, 0.6 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b4 = gl - 1;
ge4 = tan(pi * 800.0 * pow(6.25, s_p_4 / 100) / sr4);
ke4 = max(0, 1 - abs(s_w_4)) * 0.3333333333333333 + max(0, 1 - abs(s_w_4 - 1)) * 1.0 + max(0, 1 - abs(s_w_4 - 2)) * 2.0;
th = s_g_5 / 100;
gl = (th >= 0.5) * pow(10, 0.45 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b5 = gl - 1;
ge5 = tan(pi * 3000.0 * pow(6.666666666666667, s_p_5 / 100) / sr4);
ke5 = max(0, 1 - abs(s_w_5)) * 0.3333333333333333 + max(0, 1 - abs(s_w_5 - 1)) * 1.0 + max(0, 1 - abs(s_w_5 - 2)) * 2.0;
mg = s_growl / 100;
mt = s_nastro / 100;
glp = tan(pi * 350.0 / sr4);
ghg = tan(pi * 0.9756198011533183 / sr4);
kcb = 1 / (sr4 * 0.0022);
kc = 1 / (sr4 * 0.48543689320388356);

// livelli: 1,0 digitale = 4.361 V; dominio interno -6 dB
// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
L_e = ap(hb, 8, L_e, 0.3650536901969154);
L_e = ap(hb, 12, L_e, 0.5755010797915323);
L_e = ap(hb, 16, L_e, 0.7526447471286863);
L_e = ap(hb, 20, L_e, 0.8980636464339091);
L_o = ap(hb, 2, L_o, 0.07350243453590219);
L_o = ap(hb, 6, L_o, 0.25649919975582064);
L_o = ap(hb, 10, L_o, 0.47327898479453656);
L_o = ap(hb, 14, L_o, 0.6688095014357188);
L_o = ap(hb, 18, L_o, 0.8282265929955738);
L_o = ap(hb, 22, L_o, 0.9656701590349398);
L_u0 = L_e;
L_u1 = L_e;
L_u0 = ap(hb, 24, L_u0, 0.04245470986526787);
L_u0 = ap(hb, 28, L_u0, 0.39331989319033134);
L_u1 = ap(hb, 26, L_u1, 0.17073985049750015);
L_u1 = ap(hb, 30, L_u1, 0.7457135887202412);
L_u2 = L_o;
L_u3 = L_o;
L_u2 = ap(hb, 24, L_u2, 0.04245470986526787);
L_u2 = ap(hb, 28, L_u2, 0.39331989319033134);
L_u3 = ap(hb, 26, L_u3, 0.17073985049750015);
L_u3 = ap(hb, 30, L_u3, 0.7457135887202412);
x = L_u0;
// banca: spina HP4 ai 4 crossover
p0 = x;
lp, bp, hp = svf(sv, 0, p0, gx0, 1.4142135623730951);
p1 = hp;
lp, bp, hp = svf(sv, 2, p1, gx0, 1.4142135623730951);
p1 = hp;
lp, bp, hp = svf(sv, 4, p1, gx1, 1.4142135623730951);
p2 = hp;
lp, bp, hp = svf(sv, 6, p2, gx1, 1.4142135623730951);
p2 = hp;
lp, bp, hp = svf(sv, 8, p2, gx2, 1.4142135623730951);
p3 = hp;
lp, bp, hp = svf(sv, 10, p3, gx2, 1.4142135623730951);
p3 = hp;
lp, bp, hp = svf(sv, 12, p3, gx3, 1.4142135623730951);
p4 = hp;
lp, bp, hp = svf(sv, 14, p4, gx3, 1.4142135623730951);
p4 = hp;
// vie: LP4 dalla presa e allpass dei crossover sopra
y = p0;
lp, bp, hp = svf(sv, 16, y, gx0, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 18, y, gx0, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 20, y, gx1, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
lp, bp, hp = svf(sv, 22, y, gx2, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
lp, bp, hp = svf(sv, 24, y, gx3, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
v0 = y;
y = p1;
lp, bp, hp = svf(sv, 26, y, gx1, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 28, y, gx1, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 30, y, gx2, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
lp, bp, hp = svf(sv, 32, y, gx3, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
v1 = y;
y = p2;
lp, bp, hp = svf(sv, 34, y, gx2, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 36, y, gx2, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 38, y, gx3, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
v2 = y;
y = p3;
lp, bp, hp = svf(sv, 40, y, gx3, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 42, y, gx3, 1.4142135623730951);
y = lp;
v3 = y;
y = a0 * v0 + a1 * v1 + a2 * v2 + a3 * v3 + a4 * p4;
// EQ creativo: 5 campane in serie
lp, bp, hp = svf(sv, 44, y, ge1, ke1);
y = y + b1 * ke1 * bp;
lp, bp, hp = svf(sv, 46, y, ge2, ke2);
y = y + b2 * ke2 * bp;
lp, bp, hp = svf(sv, 48, y, ge3, ke3);
y = y + b3 * ke3 * bp;
lp, bp, hp = svf(sv, 50, y, ge4, ke4);
y = y + b4 * ke4 * bp;
lp, bp, hp = svf(sv, 52, y, ge5, ke5);
y = y + b5 * ke5 * bp;
// GROWL (sotto 350 Hz) e NASTRO, volt del dominio interno
x = y * 2.180432973121504;
lp, bp, hp = svf(sv, 54, x, glp, 1.4142135623730951);
dg = 0.613 * hp1(sa, 0, clipg(lp), ghg) - lp;
y1 = x + mg * dg;
vs2 = 2.017546946859815 + peek(sa, 1);
vc = 14.637421755233643 + peek(sa, 3);
idd = 0.002241718829844239 + peek(sa, 2);
idd = jstep(y1, vs2, vc, idd);
idd = jstep(y1, vs2, vc, idd);
idd = jstep(y1, vs2, vc, idd);
idd = jstep(y1, vs2, vc, idd);
vd = 1455.0392860607237 * (0.012 + vc / 48543.68932038835 - idd);
vtac = vd - vc;
poke(sa, vs2 + kcb * (idd - vs2 / 900.0) - 2.017546946859815, 1);
poke(sa, idd - 0.002241718829844239, 2);
poke(sa, vc + kc * vtac - 14.637421755233643, 3);
dt = -0.206 * vtac - y1;
L_y0 = (y1 + mt * dt) / 2.180432973121504;
x = L_u1;
// banca: spina HP4 ai 4 crossover
p0 = x;
lp, bp, hp = svf(sv, 0, p0, gx0, 1.4142135623730951);
p1 = hp;
lp, bp, hp = svf(sv, 2, p1, gx0, 1.4142135623730951);
p1 = hp;
lp, bp, hp = svf(sv, 4, p1, gx1, 1.4142135623730951);
p2 = hp;
lp, bp, hp = svf(sv, 6, p2, gx1, 1.4142135623730951);
p2 = hp;
lp, bp, hp = svf(sv, 8, p2, gx2, 1.4142135623730951);
p3 = hp;
lp, bp, hp = svf(sv, 10, p3, gx2, 1.4142135623730951);
p3 = hp;
lp, bp, hp = svf(sv, 12, p3, gx3, 1.4142135623730951);
p4 = hp;
lp, bp, hp = svf(sv, 14, p4, gx3, 1.4142135623730951);
p4 = hp;
// vie: LP4 dalla presa e allpass dei crossover sopra
y = p0;
lp, bp, hp = svf(sv, 16, y, gx0, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 18, y, gx0, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 20, y, gx1, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
lp, bp, hp = svf(sv, 22, y, gx2, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
lp, bp, hp = svf(sv, 24, y, gx3, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
v0 = y;
y = p1;
lp, bp, hp = svf(sv, 26, y, gx1, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 28, y, gx1, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 30, y, gx2, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
lp, bp, hp = svf(sv, 32, y, gx3, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
v1 = y;
y = p2;
lp, bp, hp = svf(sv, 34, y, gx2, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 36, y, gx2, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 38, y, gx3, 1.4142135623730951);
y = y - 2.8284271247461903 * bp;
v2 = y;
y = p3;
lp, bp, hp = svf(sv, 40, y, gx3, 1.4142135623730951);
y = lp;
lp, bp, hp = svf(sv, 42, y, gx3, 1.4142135623730951);
y = lp;
v3 = y;
y = a0 * v0 + a1 * v1 + a2 * v2 + a3 * v3 + a4 * p4;
// EQ creativo: 5 campane in serie
lp, bp, hp = svf(sv, 44, y, ge1, ke1);
y = y + b1 * ke1 * bp;
lp, bp, hp = svf(sv, 46, y, ge2, ke2);
y = y + b2 * ke2 * bp;
lp, bp, hp = svf(sv, 48, y, ge3, ke3);
y = y + b3 * ke3 * bp;
lp, bp, hp = svf(sv, 50, y, ge4, ke4);
y = y + b4 * ke4 * bp;
lp, bp, hp = svf(sv, 52, y, ge5, ke5);
y = y + b5 * ke5 * bp;
// GROWL (sotto 350 Hz) e NASTRO, volt del dominio interno
x = y * 2.180432973121504;
lp, bp, hp = svf(sv, 54, x, glp, 1.4142135623730951);
dg = 0.613 * hp1(sa, 0, clipg(lp), ghg) - lp;
y1 = x + mg * dg;
vs2 = 2.017546946859815 + peek(sa, 1);
vc = 14.637421755233643 + peek(sa, 3);
idd = 0.002241718829844239 + peek(sa, 2);
idd = jstep(y1, vs2, vc, idd);
idd = jstep(y1, vs2, vc, idd);
idd = jstep(y1, vs2, vc, idd);
idd = jstep(y1, vs2, vc, idd);
vd = 1455.0392860607237 * (0.012 + vc / 48543.68932038835 - idd);
vtac = vd - vc;
poke(sa, vs2 + kcb * (idd - vs2 / 900.0) - 2.017546946859815, 1);
poke(sa, idd - 0.002241718829844239, 2);
poke(sa, vc + kc * vtac - 14.637421755233643, 3);
