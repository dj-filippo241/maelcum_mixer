// MC-5WAY-S - prototipo Max P2 del 5-way maelcum_mixer.
// GENERATO da proto-max/coefficienti/genera_5way.py: non modificare.
// Banca LR4 allineata in fase (5 vie, kill netti), 5 celle a campana,
// GROWL e NASTRO in parallelo al pulito. Tutto a 4x.

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

// SVF 2 poli TPT lineare, uscita LP; stato in m[i], m[i+1]; k = 1/Q
svlp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fl;
}

// SVF 2 poli TPT lineare, uscita BP; stato in m[i], m[i+1]; k = 1/Q
svbp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fb;
}

// SVF 2 poli TPT lineare, uscita HP; stato in m[i], m[i+1]; k = 1/Q
svhp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fh;
}

// passa-alto del 1o ordine TPT (condensatore di accoppiamento)
hp1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return x - lo;
}

// clipper del GROWL: 10k in, 22k || (1 diodo + 2,2k) || (3 diodi +
// 2,2k); Newton sulla tensione dei diodi del ramo che conduce
clipg(low) {
	ii = low / 10000.0;
	pos = ii >= 0;
	a = abs(ii);
	rr = pos * 2200.568 + (1 - pos) * 2201.704;
	nv = pos * 0.04531548 + (1 - pos) * 0.13594644;
	vd = nv * log(1 + a / 2.52e-09);
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 47000.0) + vd / 47000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 47000.0) + 1 / 47000.0;
	vd = vd - f / df;
	id = 2.52e-09 * (exp(vd / nv) - 1);
	return 47000.0 * (a - id) * (pos * 2 - 1);
}

// polo singolo TPT, uscita passa-basso; stato in m[i]
op1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return lo;
}

// clipper dell'EXCITER: 10k in, 100k || (1 diodo + 1k) || (2 diodi + 1k)
clipe(h) {
	ii = h / 10000.0;
	pos = ii >= 0;
	a = abs(ii);
	rr = pos * 1000.568 + (1 - pos) * 1001.136;
	nv = pos * 0.04531548 + (1 - pos) * 0.09063096;
	vd = nv * log(1 + a / 2.52e-09);
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	ex = exp(vd / nv);
	f = 2.52e-09 * (ex - 1) * (1 + rr / 100000.0) + vd / 100000.0 - a;
	df = 2.52e-09 * ex / nv * (1 + rr / 100000.0) + 1 / 100000.0;
	vd = vd - f / df;
	id = 2.52e-09 * (exp(vd / nv) - 1);
	return 100000.0 * (a - id) * (pos * 2 - 1);
}

// CLASSE A: un passo di Newton su Vbe (Gummel-Poon ridotto, 2N3904);
// m[i] = Vc stimata, m[i+1] = Ic
bstep(m, i, vbe, vb, ve2, vth, rp) {
	ex = exp(vbe / 0.025865);
	q1 = 1 / (1 - (vb - peek(m, i)) / 74.03);
	q2 = 6.734e-15 * (ex - 1) / 0.06678;
	sq = sqrt(1 + 4 * q2);
	qb = 0.5 * q1 * (1 + sq);
	ic = 6.734e-15 * (ex - 1) / qb;
	ie = ic * 1.0024015369836696;
	f = vbe + 100.0 * ie + ve2 - vb;
	df = 1 + 100.0 * ie / 0.025865 / sq;
	poke(m, max(vth - rp * ic, ve2 + 100.0 * ie + 0.15), i);
	poke(m, ic, i + 1);
	return min(max(vbe - f / df, 0.3), 0.9);
}

// NASTRO LIBERO: gate dietro 10k, diodo gate-source verso gvs;
// Newton dall'alto
gatev(gin, gvs) {
	gvg = gvs + 0.025865 * log(1 + max(gin - gvs, 0) / 1e-10);
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	gax = exp((gvg - gvs) / 0.025865);
	gf = gvg + 1e-10 * (gax - 1) - gin;
	gdf = 1 + 3.866228494104002e-09 * gax;
	gvg = gvg - gf / gdf;
	return gvg;
}

// un passo di Newton sulla corrente del JFET (Shichman-Hodges,
// saturazione o triodo); drain su Rd e sul sommatore (vc)
jstep(vg, vs2, vc, idd) {
	vd = 1455.0392860607237 * (0.012 + vc / 48543.68932038835 - idd);
	vs = vs2 + 150.0 * idd;
	vov = max(vg - vs - (-3.0), 0);
	vds = vd - vs;
	sat = vds >= vov;
	cl = 1 + 0.006 * vds;
	q = vds * (2 * vov - vds);
	i = sat * 0.005 * vov * vov * cl + (1 - sat) * 0.005 * q * cl;
	dgs = sat * 0.01 * vov * cl + (1 - sat) * 0.01 * vds * cl;
	dds = sat * 3e-05 * vov * vov + (1 - sat) * 0.005 * ((2 * vov - 2 * vds) * cl + q * 0.006);
	df = 1 + dgs * 150.0 + dds * (1605.0392860607237);
	return max(idd - (idd - i) / df, 0);
}

Param k_sub(0, min=0, max=1);
Param k_kick(0, min=0, max=1);
Param k_mid(0, min=0, max=1);
Param k_high(0, min=0, max=1);
Param k_super(0, min=0, max=1);
Param g_1(50, min=0, max=100);
Param g_2(50, min=0, max=100);
Param g_3(50, min=0, max=100);
Param g_4(50, min=0, max=100);
Param g_5(50, min=0, max=100);
Param p_1(50, min=0, max=100);
Param p_2(50, min=0, max=100);
Param p_3(50, min=0, max=100);
Param p_4(50, min=0, max=100);
Param p_5(50, min=0, max=100);
Param w_1(1, min=0, max=2);
Param w_2(1, min=0, max=2);
Param w_3(1, min=0, max=2);
Param w_4(1, min=0, max=2);
Param w_5(1, min=0, max=2);
Param growl(0, min=0, max=100);
Param nastro(0, min=0, max=100);
Data sv(120);
Data sa(36);
Data hb(128);
History s_g_1(50);
History s_g_2(50);
History s_g_3(50);
History s_g_4(50);
History s_g_5(50);
History s_p_1(50);
History s_p_2(50);
History s_p_3(50);
History s_p_4(50);
History s_p_5(50);
History s_w_1(1);
History s_w_2(1);
History s_w_3(1);
History s_w_4(1);
History s_w_5(1);
History s_growl(50);
History s_nastro(0);

// manopole lisciate 10 ms; WIDTH 1 ms; CROSSOVER 20 ms; KILL netti
t1 = exp(-1 / (0.001 * samplerate));
t10 = exp(-1 / (0.010 * samplerate));
t20 = exp(-1 / (0.020 * samplerate));
s_g_1 = g_1 + t10 * (s_g_1 - g_1);
s_g_2 = g_2 + t10 * (s_g_2 - g_2);
s_g_3 = g_3 + t10 * (s_g_3 - g_3);
s_g_4 = g_4 + t10 * (s_g_4 - g_4);
s_g_5 = g_5 + t10 * (s_g_5 - g_5);
s_p_1 = p_1 + t10 * (s_p_1 - p_1);
s_p_2 = p_2 + t10 * (s_p_2 - p_2);
s_p_3 = p_3 + t10 * (s_p_3 - p_3);
s_p_4 = p_4 + t10 * (s_p_4 - p_4);
s_p_5 = p_5 + t10 * (s_p_5 - p_5);
s_w_1 = w_1 + t1 * (s_w_1 - w_1);
s_w_2 = w_2 + t1 * (s_w_2 - w_2);
s_w_3 = w_3 + t1 * (s_w_3 - w_3);
s_w_4 = w_4 + t1 * (s_w_4 - w_4);
s_w_5 = w_5 + t1 * (s_w_5 - w_5);
s_growl = growl + t10 * (s_growl - growl);
s_nastro = nastro + t10 * (s_nastro - nastro);
sr4 = samplerate * 4;

// CROSSOVER E 80/170/1.2k/6k
gx0 = tan(pi * 80.0 / sr4);
gx1 = tan(pi * 170.0 / sr4);
gx2 = tan(pi * 1200.0 / sr4);
gx3 = tan(pi * 6000.0 / sr4);

// KILL: 1 = via aperta (interruttore, taglio netto: dec. 88)
a0 = 1 - k_sub;
a1 = 1 - k_kick;
a2 = 1 - k_mid;
a3 = 1 - k_high;
a4 = 1 - k_super;

// celle EQ: GAIN (famiglia eq-serie §10), POSITION esponenziale,
// WIDTH Q 3 / 1 / 0,5
th = s_g_1 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b1 = gl - 1;
ge1 = tan(pi * 20.0 * pow(6.0, s_p_1 / 100) / sr4);
ke1 = max(0, 1 - abs(s_w_1)) * 0.3333333333333333 + max(0, 1 - abs(s_w_1 - 1)) * 1.0 + max(0, 1 - abs(s_w_1 - 2)) * 2.0;
th = s_g_2 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b2 = gl - 1;
ge2 = tan(pi * 80.0 * pow(5.0, s_p_2 / 100) / sr4);
ke2 = max(0, 1 - abs(s_w_2)) * 0.3333333333333333 + max(0, 1 - abs(s_w_2 - 1)) * 1.0 + max(0, 1 - abs(s_w_2 - 2)) * 2.0;
th = s_g_3 / 100;
gl = (th >= 0.5) * pow(10, 0.75 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b3 = gl - 1;
ge3 = tan(pi * 250.0 * pow(6.0, s_p_3 / 100) / sr4);
ke3 = max(0, 1 - abs(s_w_3)) * 0.3333333333333333 + max(0, 1 - abs(s_w_3 - 1)) * 1.0 + max(0, 1 - abs(s_w_3 - 2)) * 2.0;
th = s_g_4 / 100;
gl = (th >= 0.5) * pow(10, 0.6 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b4 = gl - 1;
ge4 = tan(pi * 800.0 * pow(6.25, s_p_4 / 100) / sr4);
ke4 = max(0, 1 - abs(s_w_4)) * 0.3333333333333333 + max(0, 1 - abs(s_w_4 - 1)) * 1.0 + max(0, 1 - abs(s_w_4 - 2)) * 2.0;
th = s_g_5 / 100;
gl = (th >= 0.5) * pow(10, 0.45 * (th - 0.5) / 0.5) + (th < 0.5) * (th >= 0.05) * pow(10, -1.35 * (0.5 - th) / 0.45) + (th < 0.05) * 0.0446683592150963 * th / 0.05;
b5 = gl - 1;
ge5 = tan(pi * 3000.0 * pow(6.666666666666667, s_p_5 / 100) / sr4);
ke5 = max(0, 1 - abs(s_w_5)) * 0.3333333333333333 + max(0, 1 - abs(s_w_5 - 1)) * 1.0 + max(0, 1 - abs(s_w_5 - 2)) * 2.0;
mg = s_growl / 100;
tn = s_nastro / 100;
mt = 0.85 * ((tn <= 0.5) * 0.1 * tn / 0.5 + (tn > 0.5) * (0.1 + 0.9 * (tn - 0.5) / 0.5));
// NASTRO LIBERO: spinta 0 -> +12 dB con la manopola
gnl = pow(10, 0.6 * tn);
// GROWL LIBERO (spinta 0 -> +18 dB col pot)
gg = pow(10, 0.9 * mg);
kk = 0.6043;
glp = tan(pi * 350.0 / sr4);
ghg = tan(pi * 0.7375240062878429 / sr4);
kcb = 1 / (sr4 * 0.0022);
kc = 1 / (sr4 * 0.48543689320388356);
gcp = tan(pi * 5000.0 / sr4);
gcz = tan(pi * 1500.0 / sr4);
ghb = tan(pi * 80.0 / sr4);
gex = tan(pi * 3000.0 / sr4);
kce = 1 / (sr4 * 0.0022);
kcc = 1 / (sr4 * 1.11731843575419);

// livelli: 1,0 digitale = 4.361 V; dominio interno -6 dB
// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
L_e = ap(hb, 8, L_e, 0.3650536901969154);
L_e = ap(hb, 12, L_e, 0.5755010797915323);
L_e = ap(hb, 16, L_e, 0.7526447471286863);
L_e = ap(hb, 20, L_e, 0.8980636464339091);
L_o = ap(hb, 2, L_o, 0.07350243453590219);
L_o = ap(hb, 6, L_o, 0.25649919975582064);
L_o = ap(hb, 10, L_o, 0.47327898479453656);
L_o = ap(hb, 14, L_o, 0.6688095014357188);
L_o = ap(hb, 18, L_o, 0.8282265929955738);
L_o = ap(hb, 22, L_o, 0.9656701590349398);
L_u0 = L_e;
L_u1 = L_e;
L_u0 = ap(hb, 24, L_u0, 0.04245470986526787);
L_u0 = ap(hb, 28, L_u0, 0.39331989319033134);
L_u1 = ap(hb, 26, L_u1, 0.17073985049750015);
L_u1 = ap(hb, 30, L_u1, 0.7457135887202412);
L_u2 = L_o;
L_u3 = L_o;
L_u2 = ap(hb, 24, L_u2, 0.04245470986526787);
L_u2 = ap(hb, 28, L_u2, 0.39331989319033134);
L_u3 = ap(hb, 26, L_u3, 0.17073985049750015);
L_u3 = ap(hb, 30, L_u3, 0.7457135887202412);
xa = L_u0;
// banca: spina HP4 ai 4 crossover
p0 = xa;
p1 = svhp(sv, 0, p0, gx0, 1.4142135623730951);
p1 = svhp(sv, 2, p1, gx0, 1.4142135623730951);
p2 = svhp(sv, 4, p1, gx1, 1.4142135623730951);
p2 = svhp(sv, 6, p2, gx1, 1.4142135623730951);
p3 = svhp(sv, 8, p2, gx2, 1.4142135623730951);
p3 = svhp(sv, 10, p3, gx2, 1.4142135623730951);
p4 = svhp(sv, 12, p3, gx3, 1.4142135623730951);
p4 = svhp(sv, 14, p4, gx3, 1.4142135623730951);
// vie: LP4 dalla presa e allpass dei crossover sopra
ya = p0;
ya = svlp(sv, 16, ya, gx0, 1.4142135623730951);
ya = svlp(sv, 18, ya, gx0, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 20, ya, gx1, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 22, ya, gx2, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 24, ya, gx3, 1.4142135623730951);
v0 = ya;
ya = p1;
ya = svlp(sv, 26, ya, gx1, 1.4142135623730951);
ya = svlp(sv, 28, ya, gx1, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 30, ya, gx2, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 32, ya, gx3, 1.4142135623730951);
v1 = ya;
ya = p2;
ya = svlp(sv, 34, ya, gx2, 1.4142135623730951);
ya = svlp(sv, 36, ya, gx2, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 38, ya, gx3, 1.4142135623730951);
v2 = ya;
ya = p3;
ya = svlp(sv, 40, ya, gx3, 1.4142135623730951);
ya = svlp(sv, 42, ya, gx3, 1.4142135623730951);
v3 = ya;
ya = a0 * v0 + a1 * v1 + a2 * v2 + a3 * v3 + a4 * p4;
// EQ creativo: 5 campane in serie
ya = ya + b1 * ke1 * svbp(sv, 44, ya, ge1, ke1);
ya = ya + b2 * ke2 * svbp(sv, 46, ya, ge2, ke2);
ya = ya + b3 * ke3 * svbp(sv, 48, ya, ge3, ke3);
ya = ya + b4 * ke4 * svbp(sv, 50, ya, ge4, ke4);
ya = ya + b5 * ke5 * svbp(sv, 52, ya, ge5, ke5);
// GROWL (sotto 350 Hz) e NASTRO, volt del dominio interno
xa = ya * 2.180432973121504;
lw = svlp(sv, 54, xa, glp, 1.4142135623730951);
dg = kk * hp1(sa, 0, clipg(gg * lw), ghg) - lw;
y1 = xa + mg * dg;
exh = svhp(sv, 58, y1, gex, 1.4142135623730951);
dex = 0.30509 * hp1(sa, 9, clipe(exh), gex);
L_y0 = (y1 + mt * dex) / 2.180432973121504;
xa = L_u1;
// banca: spina HP4 ai 4 crossover
p0 = xa;
p1 = svhp(sv, 0, p0, gx0, 1.4142135623730951);
p1 = svhp(sv, 2, p1, gx0, 1.4142135623730951);
p2 = svhp(sv, 4, p1, gx1, 1.4142135623730951);
p2 = svhp(sv, 6, p2, gx1, 1.4142135623730951);
p3 = svhp(sv, 8, p2, gx2, 1.4142135623730951);
p3 = svhp(sv, 10, p3, gx2, 1.4142135623730951);
p4 = svhp(sv, 12, p3, gx3, 1.4142135623730951);
p4 = svhp(sv, 14, p4, gx3, 1.4142135623730951);
// vie: LP4 dalla presa e allpass dei crossover sopra
ya = p0;
ya = svlp(sv, 16, ya, gx0, 1.4142135623730951);
ya = svlp(sv, 18, ya, gx0, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 20, ya, gx1, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 22, ya, gx2, 1.4142135623730951);
ya = ya - 2.8284271247461903 * svbp(sv, 24, ya, gx3, 1.4142135623730951);
