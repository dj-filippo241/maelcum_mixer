R3Chi = bq(st, 50, R3Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R_y3 = g_low * R3Cl + g_lowmid * R3Clm + g_midhigh * R3Cmh + g_high * R3Chi;
d0 = R_y1;
d1 = R_y0;
d0 = ap(hb, 96, d0, 0.04245470986526787);
