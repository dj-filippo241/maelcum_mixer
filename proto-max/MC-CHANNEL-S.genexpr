// MC-CHANNEL-S - prototipo Max P0 del canale maelcum_mixer.
// GENERATO da proto-max/coefficienti/genera.py: non modificare a mano.
// GAIN -inf..0..+10 dB, isolator a 4 bande (0..+6 dB, silenzio a
// fondo corsa), fader. Banca a 4x della frequenza di campionamento.

// biquad in forma trasposta II; stato in m[i], m[i+1]
bq(m, i, x, b0, b1, b2, a1, a2) {
	y = b0 * x + peek(m, i);
	poke(m, b1 * x - a1 * y + peek(m, i + 1), i);
	poke(m, b2 * x - a2 * y, i + 1);
	return y;
}

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

Param gain(50.0, min=0, max=100);
Param low(50.0, min=0, max=100);
Param lowmid(50.0, min=0, max=100);
Param midhigh(50.0, min=0, max=100);
Param high(50.0, min=0, max=100);
Param fader(100.0, min=0, max=100);
Data st(52);
Data hb(128);
History s_gain(50.0);
History s_low(50.0);
History s_lowmid(50.0);
History s_midhigh(50.0);
History s_high(50.0);
History s_fader(100.0);

// manopole lisciate: 10 ms (selettore 20 ms, dissolvenza A/B)
t10 = exp(-1 / (0.010 * samplerate));
t20 = exp(-1 / (0.020 * samplerate));
s_gain = gain + t10 * (s_gain - gain);
s_low = low + t10 * (s_low - low);
s_lowmid = lowmid + t10 * (s_lowmid - lowmid);
s_midhigh = midhigh + t10 * (s_midhigh - midhigh);
s_high = high + t10 * (s_high - high);
s_fader = fader + t10 * (s_fader - fader);

// GAIN a pot doppio (dec. 162, T1): partitore caricato Rl/R 0,43, x3,15;
// meta CCW = trim, silenzio a fondo corsa; meta CW 0..+10 dB
tg = s_gain / 100;
lo_g = tg * 0.43 / (tg + 0.43);
g_gain = 3.15 * lo_g / (lo_g + 1 - tg);
// bande: pot lineare x2, oppure curva Pioneer ideale (docs/09 §7):
// taglio (2 theta)^1,5, boost uguale; a fondo corsa il contatto da silenzio
x_low = 2 * s_low / 100;
g_low = x_low * max(low > 0, s_low > 0.001);
x_lowmid = 2 * s_lowmid / 100;
g_lowmid = x_lowmid * max(lowmid > 0, s_lowmid > 0.001);
x_midhigh = 2 * s_midhigh / 100;
g_midhigh = x_midhigh * max(midhigh > 0, s_midhigh > 0.001);
x_high = 2 * s_high / 100;
g_high = x_high * max(high > 0, s_high > 0.001);
// fader [PROVVISORIO]: curva quadratica, -12 dB a meta corsa
tf = s_fader / 100;
g_fader = tf * tf;

// coefficienti degli incroci (bilineare con prewarp)
// LR4: Q 0,7071 due volte; LR2: Q 0,5 una volta
sr4 = samplerate * 4;
C1_k = tan(pi * 150.0 / sr4);
C1_kk = C1_k * C1_k;
C1_n = 1 / (1 + C1_k * 2.0 + C1_kk);
C1_a1 = 2 * (C1_kk - 1) * C1_n;
C1_a2 = (1 - C1_k * 2.0 + C1_kk) * C1_n;
C1_lb = C1_kk * C1_n;
C2_k = tan(pi * 350.0 / sr4);
C2_kk = C2_k * C2_k;
C2_n = 1 / (1 + C2_k * 1.4142135623730951 + C2_kk);
C2_a1 = 2 * (C2_kk - 1) * C2_n;
C2_a2 = (1 - C2_k * 1.4142135623730951 + C2_kk) * C2_n;
C2_lb = C2_kk * C2_n;
C3_k = tan(pi * 3150.0 / sr4);
C3_kk = C3_k * C3_k;
C3_n = 1 / (1 + C3_k * 1.4142135623730951 + C3_kk);
C3_a1 = 2 * (C3_kk - 1) * C3_n;
C3_a2 = (1 - C3_k * 1.4142135623730951 + C3_kk) * C3_n;
C3_lb = C3_kk * C3_n;

// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
L_e = ap(hb, 8, L_e, 0.3650536901969154);
L_e = ap(hb, 12, L_e, 0.5755010797915323);
L_e = ap(hb, 16, L_e, 0.7526447471286863);
L_e = ap(hb, 20, L_e, 0.8980636464339091);
L_o = ap(hb, 2, L_o, 0.07350243453590219);
L_o = ap(hb, 6, L_o, 0.25649919975582064);
L_o = ap(hb, 10, L_o, 0.47327898479453656);
L_o = ap(hb, 14, L_o, 0.6688095014357188);
L_o = ap(hb, 18, L_o, 0.8282265929955738);
L_o = ap(hb, 22, L_o, 0.9656701590349398);
L_u0 = L_e;
L_u1 = L_e;
L_u0 = ap(hb, 24, L_u0, 0.04245470986526787);
L_u0 = ap(hb, 28, L_u0, 0.39331989319033134);
L_u1 = ap(hb, 26, L_u1, 0.17073985049750015);
L_u1 = ap(hb, 30, L_u1, 0.7457135887202412);
L_u2 = L_o;
L_u3 = L_o;
L_u2 = ap(hb, 24, L_u2, 0.04245470986526787);
L_u2 = ap(hb, 28, L_u2, 0.39331989319033134);
L_u3 = ap(hb, 26, L_u3, 0.17073985049750015);
L_u3 = ap(hb, 30, L_u3, 0.7457135887202412);
L0Cl = bq(st, 0, L_u0, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L0Cl = bq(st, 2, L0Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
L0Cl = bq(st, 4, L0Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L0Ch1 = bq(st, 6, L_u0, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
L0Ch1 = -L0Ch1;
L0Clm = bq(st, 8, L0Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L0Clm = bq(st, 10, L0Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L0Clm = bq(st, 12, L0Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L0Ch2 = bq(st, 14, L0Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L0Ch2 = bq(st, 16, L0Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L0Cmh = bq(st, 18, L0Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L0Cmh = bq(st, 20, L0Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L0Chi = bq(st, 22, L0Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L0Chi = bq(st, 24, L0Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L_y0 = g_low * L0Cl + g_lowmid * L0Clm + g_midhigh * L0Cmh + g_high * L0Chi;
L1Cl = bq(st, 0, L_u1, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L1Cl = bq(st, 2, L1Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
L1Cl = bq(st, 4, L1Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L1Ch1 = bq(st, 6, L_u1, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
L1Ch1 = -L1Ch1;
L1Clm = bq(st, 8, L1Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L1Clm = bq(st, 10, L1Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L1Clm = bq(st, 12, L1Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L1Ch2 = bq(st, 14, L1Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L1Ch2 = bq(st, 16, L1Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L1Cmh = bq(st, 18, L1Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L1Cmh = bq(st, 20, L1Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L1Chi = bq(st, 22, L1Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L1Chi = bq(st, 24, L1Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L_y1 = g_low * L1Cl + g_lowmid * L1Clm + g_midhigh * L1Cmh + g_high * L1Chi;
L2Cl = bq(st, 0, L_u2, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L2Cl = bq(st, 2, L2Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
L2Cl = bq(st, 4, L2Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L2Ch1 = bq(st, 6, L_u2, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
L2Ch1 = -L2Ch1;
L2Clm = bq(st, 8, L2Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L2Clm = bq(st, 10, L2Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L2Clm = bq(st, 12, L2Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L2Ch2 = bq(st, 14, L2Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L2Ch2 = bq(st, 16, L2Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L2Cmh = bq(st, 18, L2Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L2Cmh = bq(st, 20, L2Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L2Chi = bq(st, 22, L2Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L2Chi = bq(st, 24, L2Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L_y2 = g_low * L2Cl + g_lowmid * L2Clm + g_midhigh * L2Cmh + g_high * L2Chi;
L3Cl = bq(st, 0, L_u3, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L3Cl = bq(st, 2, L3Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
L3Cl = bq(st, 4, L3Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L3Ch1 = bq(st, 6, L_u3, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
L3Ch1 = -L3Ch1;
L3Clm = bq(st, 8, L3Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L3Clm = bq(st, 10, L3Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L3Clm = bq(st, 12, L3Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L3Ch2 = bq(st, 14, L3Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L3Ch2 = bq(st, 16, L3Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L3Cmh = bq(st, 18, L3Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L3Cmh = bq(st, 20, L3Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L3Chi = bq(st, 22, L3Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L3Chi = bq(st, 24, L3Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L_y3 = g_low * L3Cl + g_lowmid * L3Clm + g_midhigh * L3Cmh + g_high * L3Chi;
d0 = L_y1;
d1 = L_y0;
d0 = ap(hb, 32, d0, 0.04245470986526787);
d0 = ap(hb, 36, d0, 0.39331989319033134);
d1 = ap(hb, 34, d1, 0.17073985049750015);
d1 = ap(hb, 38, d1, 0.7457135887202412);
L_v0 = 0.5 * (d0 + d1);
d0 = L_y3;
d1 = L_y2;
d0 = ap(hb, 32, d0, 0.04245470986526787);
d0 = ap(hb, 36, d0, 0.39331989319033134);
d1 = ap(hb, 34, d1, 0.17073985049750015);
d1 = ap(hb, 38, d1, 0.7457135887202412);
L_v1 = 0.5 * (d0 + d1);
d0 = L_v1;
d1 = L_v0;
d0 = ap(hb, 40, d0, 0.019059005558478156);
d0 = ap(hb, 44, d0, 0.1559582483500435);
d0 = ap(hb, 48, d0, 0.3650536901969154);
d0 = ap(hb, 52, d0, 0.5755010797915323);
d0 = ap(hb, 56, d0, 0.7526447471286863);
d0 = ap(hb, 60, d0, 0.8980636464339091);
d1 = ap(hb, 42, d1, 0.07350243453590219);
d1 = ap(hb, 46, d1, 0.25649919975582064);
d1 = ap(hb, 50, d1, 0.47327898479453656);
d1 = ap(hb, 54, d1, 0.6688095014357188);
d1 = ap(hb, 58, d1, 0.8282265929955738);
d1 = ap(hb, 62, d1, 0.9656701590349398);
L_w = 0.5 * (d0 + d1);
L_out = g_gain * g_fader * L_w;

// ===== lato R =====
R_e = in2;
R_o = in2;
R_e = ap(hb, 64, R_e, 0.019059005558478156);
R_e = ap(hb, 68, R_e, 0.1559582483500435);
R_e = ap(hb, 72, R_e, 0.3650536901969154);
R_e = ap(hb, 76, R_e, 0.5755010797915323);
R_e = ap(hb, 80, R_e, 0.7526447471286863);
R_e = ap(hb, 84, R_e, 0.8980636464339091);
R_o = ap(hb, 66, R_o, 0.07350243453590219);
R_o = ap(hb, 70, R_o, 0.25649919975582064);
R_o = ap(hb, 74, R_o, 0.47327898479453656);
R_o = ap(hb, 78, R_o, 0.6688095014357188);
R_o = ap(hb, 82, R_o, 0.8282265929955738);
R_o = ap(hb, 86, R_o, 0.9656701590349398);
R_u0 = R_e;
R_u1 = R_e;
R_u0 = ap(hb, 88, R_u0, 0.04245470986526787);
R_u0 = ap(hb, 92, R_u0, 0.39331989319033134);
R_u1 = ap(hb, 90, R_u1, 0.17073985049750015);
R_u1 = ap(hb, 94, R_u1, 0.7457135887202412);
R_u2 = R_o;
R_u3 = R_o;
R_u2 = ap(hb, 88, R_u2, 0.04245470986526787);
R_u2 = ap(hb, 92, R_u2, 0.39331989319033134);
R_u3 = ap(hb, 90, R_u3, 0.17073985049750015);
R_u3 = ap(hb, 94, R_u3, 0.7457135887202412);
R0Cl = bq(st, 26, R_u0, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
R0Cl = bq(st, 28, R0Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
R0Cl = bq(st, 30, R0Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R0Ch1 = bq(st, 32, R_u0, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
R0Ch1 = -R0Ch1;
R0Clm = bq(st, 34, R0Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R0Clm = bq(st, 36, R0Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R0Clm = bq(st, 38, R0Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R0Ch2 = bq(st, 40, R0Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R0Ch2 = bq(st, 42, R0Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R0Cmh = bq(st, 44, R0Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
R0Cmh = bq(st, 46, R0Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
R0Chi = bq(st, 48, R0Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R0Chi = bq(st, 50, R0Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R_y0 = g_low * R0Cl + g_lowmid * R0Clm + g_midhigh * R0Cmh + g_high * R0Chi;
R1Cl = bq(st, 26, R_u1, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
R1Cl = bq(st, 28, R1Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
R1Cl = bq(st, 30, R1Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R1Ch1 = bq(st, 32, R_u1, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
R1Ch1 = -R1Ch1;
R1Clm = bq(st, 34, R1Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R1Clm = bq(st, 36, R1Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R1Clm = bq(st, 38, R1Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R1Ch2 = bq(st, 40, R1Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R1Ch2 = bq(st, 42, R1Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R1Cmh = bq(st, 44, R1Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
R1Cmh = bq(st, 46, R1Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
R1Chi = bq(st, 48, R1Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R1Chi = bq(st, 50, R1Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R_y1 = g_low * R1Cl + g_lowmid * R1Clm + g_midhigh * R1Cmh + g_high * R1Chi;
R2Cl = bq(st, 26, R_u2, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
R2Cl = bq(st, 28, R2Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
R2Cl = bq(st, 30, R2Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R2Ch1 = bq(st, 32, R_u2, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
R2Ch1 = -R2Ch1;
R2Clm = bq(st, 34, R2Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R2Clm = bq(st, 36, R2Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R2Clm = bq(st, 38, R2Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R2Ch2 = bq(st, 40, R2Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R2Ch2 = bq(st, 42, R2Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R2Cmh = bq(st, 44, R2Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
R2Cmh = bq(st, 46, R2Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
R2Chi = bq(st, 48, R2Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R2Chi = bq(st, 50, R2Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
R_y2 = g_low * R2Cl + g_lowmid * R2Clm + g_midhigh * R2Cmh + g_high * R2Chi;
R3Cl = bq(st, 26, R_u3, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
R3Cl = bq(st, 28, R3Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
R3Cl = bq(st, 30, R3Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R3Ch1 = bq(st, 32, R_u3, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
R3Ch1 = -R3Ch1;
R3Clm = bq(st, 34, R3Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R3Clm = bq(st, 36, R3Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
R3Clm = bq(st, 38, R3Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
R3Ch2 = bq(st, 40, R3Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
R3Ch2 = bq(st, 42, R3Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
