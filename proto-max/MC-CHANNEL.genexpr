// MC-CHANNEL - prototipo Max P0 del canale maelcum_mixer.
// GENERATO da proto-max/coefficienti/genera.py: non modificare a mano.
// GAIN -inf..0..+10 dB, isolator a 4 bande (0..+6 dB, silenzio a
// fondo corsa), fader. Banca a 4x della frequenza di campionamento.

// biquad in forma trasposta II; stato in m[i], m[i+1]
bq(m, i, x, b0, b1, b2, a1, a2) {
	y = b0 * x + peek(m, i);
	poke(m, b1 * x - a1 * y + peek(m, i + 1), i);
	poke(m, b2 * x - a2 * y, i + 1);
	return y;
}

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

Param gain(50.0, min=0, max=100);
Param low(50.0, min=0, max=100);
Param lowmid(50.0, min=0, max=100);
Param midhigh(50.0, min=0, max=100);
Param high(50.0, min=0, max=100);
Param fader(100.0, min=0, max=100);
Param incroci(0, min=0, max=2);
Data st(164);
Data hb(128);
History s_gain(50.0);
History s_low(50.0);
History s_lowmid(50.0);
History s_midhigh(50.0);
History s_high(50.0);
History s_fader(100.0);
History s_x(0);

// manopole lisciate: 10 ms (selettore 20 ms, dissolvenza A/B)
t10 = exp(-1 / (0.010 * samplerate));
t20 = exp(-1 / (0.020 * samplerate));
s_gain = gain + t10 * (s_gain - gain);
s_low = low + t10 * (s_low - low);
s_lowmid = lowmid + t10 * (s_lowmid - lowmid);
s_midhigh = midhigh + t10 * (s_midhigh - midhigh);
s_high = high + t10 * (s_high - high);
s_fader = fader + t10 * (s_fader - fader);
s_x = incroci + t20 * (s_x - incroci);

// GAIN: fondo corsa muto, meta CCW -100..0 dB, meta CW 0..+10 dB
tg = s_gain / 100;
g_gain = pow(10, min(200 * tg - 100, 20 * tg - 10) / 20) * (tg > 0);
// bande: pot lineare x2; a fondo corsa il contatto da silenzio
g_low = 2 * s_low / 100 * max(low > 0, s_low > 0.001);
g_lowmid = 2 * s_lowmid / 100 * max(lowmid > 0, s_lowmid > 0.001);
g_midhigh = 2 * s_midhigh / 100 * max(midhigh > 0, s_midhigh > 0.001);
g_high = 2 * s_high / 100 * max(high > 0, s_high > 0.001);
// fader [PROVVISORIO]: curva quadratica, -12 dB a meta corsa
tf = s_fader / 100;
g_fader = tf * tf;

// coefficienti degli incroci (bilineare con prewarp)
// LR4: Q 0,7071 due volte; LR2: Q 0,5 una volta
sr4 = samplerate * 4;
A1_k = tan(pi * 150.0 / sr4);
A1_kk = A1_k * A1_k;
A1_n = 1 / (1 + A1_k * 1.4142135623730951 + A1_kk);
A1_a1 = 2 * (A1_kk - 1) * A1_n;
A1_a2 = (1 - A1_k * 1.4142135623730951 + A1_kk) * A1_n;
A1_lb = A1_kk * A1_n;
A2_k = tan(pi * 500.0 / sr4);
A2_kk = A2_k * A2_k;
A2_n = 1 / (1 + A2_k * 1.4142135623730951 + A2_kk);
A2_a1 = 2 * (A2_kk - 1) * A2_n;
A2_a2 = (1 - A2_k * 1.4142135623730951 + A2_kk) * A2_n;
A2_lb = A2_kk * A2_n;
A3_k = tan(pi * 2500.0 / sr4);
A3_kk = A3_k * A3_k;
A3_n = 1 / (1 + A3_k * 1.4142135623730951 + A3_kk);
A3_a1 = 2 * (A3_kk - 1) * A3_n;
A3_a2 = (1 - A3_k * 1.4142135623730951 + A3_kk) * A3_n;
A3_lb = A3_kk * A3_n;
C1_k = tan(pi * 150.0 / sr4);
C1_kk = C1_k * C1_k;
C1_n = 1 / (1 + C1_k * 2.0 + C1_kk);
C1_a1 = 2 * (C1_kk - 1) * C1_n;
C1_a2 = (1 - C1_k * 2.0 + C1_kk) * C1_n;
C1_lb = C1_kk * C1_n;
C2_k = tan(pi * 350.0 / sr4);
C2_kk = C2_k * C2_k;
C2_n = 1 / (1 + C2_k * 1.4142135623730951 + C2_kk);
C2_a1 = 2 * (C2_kk - 1) * C2_n;
C2_a2 = (1 - C2_k * 1.4142135623730951 + C2_kk) * C2_n;
C2_lb = C2_kk * C2_n;
C3_k = tan(pi * 3150.0 / sr4);
C3_kk = C3_k * C3_k;
C3_n = 1 / (1 + C3_k * 1.4142135623730951 + C3_kk);
C3_a1 = 2 * (C3_kk - 1) * C3_n;
C3_a2 = (1 - C3_k * 1.4142135623730951 + C3_kk) * C3_n;
C3_lb = C3_kk * C3_n;
D1_k = tan(pi * 150.0 / sr4);
D1_kk = D1_k * D1_k;
D1_n = 1 / (1 + D1_k * 2.0 + D1_kk);
D1_a1 = 2 * (D1_kk - 1) * D1_n;
D1_a2 = (1 - D1_k * 2.0 + D1_kk) * D1_n;
D1_lb = D1_kk * D1_n;
D2_k = tan(pi * 700.0 / sr4);
D2_kk = D2_k * D2_k;
D2_n = 1 / (1 + D2_k * 1.4142135623730951 + D2_kk);
D2_a1 = 2 * (D2_kk - 1) * D2_n;
D2_a2 = (1 - D2_k * 1.4142135623730951 + D2_kk) * D2_n;
D2_lb = D2_kk * D2_n;
D3_k = tan(pi * 3150.0 / sr4);
D3_kk = D3_k * D3_k;
D3_n = 1 / (1 + D3_k * 1.4142135623730951 + D3_kk);
D3_a1 = 2 * (D3_kk - 1) * D3_n;
D3_a2 = (1 - D3_k * 1.4142135623730951 + D3_kk) * D3_n;
D3_lb = D3_kk * D3_n;

// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
L_e = ap(hb, 8, L_e, 0.3650536901969154);
L_e = ap(hb, 12, L_e, 0.5755010797915323);
L_e = ap(hb, 16, L_e, 0.7526447471286863);
L_e = ap(hb, 20, L_e, 0.8980636464339091);
L_o = ap(hb, 2, L_o, 0.07350243453590219);
L_o = ap(hb, 6, L_o, 0.25649919975582064);
L_o = ap(hb, 10, L_o, 0.47327898479453656);
L_o = ap(hb, 14, L_o, 0.6688095014357188);
L_o = ap(hb, 18, L_o, 0.8282265929955738);
L_o = ap(hb, 22, L_o, 0.9656701590349398);
L_u0 = L_e;
L_u1 = L_e;
L_u0 = ap(hb, 24, L_u0, 0.04245470986526787);
L_u0 = ap(hb, 28, L_u0, 0.39331989319033134);
L_u1 = ap(hb, 26, L_u1, 0.17073985049750015);
L_u1 = ap(hb, 30, L_u1, 0.7457135887202412);
L_u2 = L_o;
L_u3 = L_o;
L_u2 = ap(hb, 24, L_u2, 0.04245470986526787);
L_u2 = ap(hb, 28, L_u2, 0.39331989319033134);
L_u3 = ap(hb, 26, L_u3, 0.17073985049750015);
L_u3 = ap(hb, 30, L_u3, 0.7457135887202412);
L0Al = bq(st, 0, L_u0, A1_lb, 2 * A1_lb, A1_lb, A1_a1, A1_a2);
L0Al = bq(st, 2, L0Al, A1_lb, 2 * A1_lb, A1_lb, A1_a1, A1_a2);
L0Al = bq(st, 4, L0Al, A2_a2, A2_a1, 1, A2_a1, A2_a2);
L0Al = bq(st, 6, L0Al, A3_a2, A3_a1, 1, A3_a1, A3_a2);
L0Ah1 = bq(st, 8, L_u0, A1_n, -2 * A1_n, A1_n, A1_a1, A1_a2);
L0Ah1 = bq(st, 10, L0Ah1, A1_n, -2 * A1_n, A1_n, A1_a1, A1_a2);
L0Alm = bq(st, 12, L0Ah1, A2_lb, 2 * A2_lb, A2_lb, A2_a1, A2_a2);
L0Alm = bq(st, 14, L0Alm, A2_lb, 2 * A2_lb, A2_lb, A2_a1, A2_a2);
L0Alm = bq(st, 16, L0Alm, A3_a2, A3_a1, 1, A3_a1, A3_a2);
L0Ah2 = bq(st, 18, L0Ah1, A2_n, -2 * A2_n, A2_n, A2_a1, A2_a2);
L0Ah2 = bq(st, 20, L0Ah2, A2_n, -2 * A2_n, A2_n, A2_a1, A2_a2);
L0Amh = bq(st, 22, L0Ah2, A3_lb, 2 * A3_lb, A3_lb, A3_a1, A3_a2);
L0Amh = bq(st, 24, L0Amh, A3_lb, 2 * A3_lb, A3_lb, A3_a1, A3_a2);
L0Ahi = bq(st, 26, L0Ah2, A3_n, -2 * A3_n, A3_n, A3_a1, A3_a2);
L0Ahi = bq(st, 28, L0Ahi, A3_n, -2 * A3_n, A3_n, A3_a1, A3_a2);
L0A = g_low * L0Al + g_lowmid * L0Alm + g_midhigh * L0Amh + g_high * L0Ahi;
L0Cl = bq(st, 30, L_u0, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L0Cl = bq(st, 32, L0Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
L0Cl = bq(st, 34, L0Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L0Ch1 = bq(st, 36, L_u0, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
L0Ch1 = -L0Ch1;
L0Clm = bq(st, 38, L0Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L0Clm = bq(st, 40, L0Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L0Clm = bq(st, 42, L0Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L0Ch2 = bq(st, 44, L0Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L0Ch2 = bq(st, 46, L0Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L0Cmh = bq(st, 48, L0Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L0Cmh = bq(st, 50, L0Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L0Chi = bq(st, 52, L0Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L0Chi = bq(st, 54, L0Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L0C = g_low * L0Cl + g_lowmid * L0Clm + g_midhigh * L0Cmh + g_high * L0Chi;
L0Dl = bq(st, 56, L_u0, D1_lb, 2 * D1_lb, D1_lb, D1_a1, D1_a2);
L0Dl = bq(st, 58, L0Dl, D2_a2, D2_a1, 1, D2_a1, D2_a2);
L0Dl = bq(st, 60, L0Dl, D3_a2, D3_a1, 1, D3_a1, D3_a2);
L0Dh1 = bq(st, 62, L_u0, D1_n, -2 * D1_n, D1_n, D1_a1, D1_a2);
L0Dh1 = -L0Dh1;
L0Dlm = bq(st, 64, L0Dh1, D2_lb, 2 * D2_lb, D2_lb, D2_a1, D2_a2);
L0Dlm = bq(st, 66, L0Dlm, D2_lb, 2 * D2_lb, D2_lb, D2_a1, D2_a2);
L0Dlm = bq(st, 68, L0Dlm, D3_a2, D3_a1, 1, D3_a1, D3_a2);
L0Dh2 = bq(st, 70, L0Dh1, D2_n, -2 * D2_n, D2_n, D2_a1, D2_a2);
L0Dh2 = bq(st, 72, L0Dh2, D2_n, -2 * D2_n, D2_n, D2_a1, D2_a2);
L0Dmh = bq(st, 74, L0Dh2, D3_lb, 2 * D3_lb, D3_lb, D3_a1, D3_a2);
L0Dmh = bq(st, 76, L0Dmh, D3_lb, 2 * D3_lb, D3_lb, D3_a1, D3_a2);
L0Dhi = bq(st, 78, L0Dh2, D3_n, -2 * D3_n, D3_n, D3_a1, D3_a2);
L0Dhi = bq(st, 80, L0Dhi, D3_n, -2 * D3_n, D3_n, D3_a1, D3_a2);
L0D = g_low * L0Dl + g_lowmid * L0Dlm + g_midhigh * L0Dmh + g_high * L0Dhi;
L_y0 = max(0, 1 - abs(s_x - 0)) * L0A + max(0, 1 - abs(s_x - 1)) * L0C + max(0, 1 - abs(s_x - 2)) * L0D;
L1Al = bq(st, 0, L_u1, A1_lb, 2 * A1_lb, A1_lb, A1_a1, A1_a2);
L1Al = bq(st, 2, L1Al, A1_lb, 2 * A1_lb, A1_lb, A1_a1, A1_a2);
L1Al = bq(st, 4, L1Al, A2_a2, A2_a1, 1, A2_a1, A2_a2);
L1Al = bq(st, 6, L1Al, A3_a2, A3_a1, 1, A3_a1, A3_a2);
L1Ah1 = bq(st, 8, L_u1, A1_n, -2 * A1_n, A1_n, A1_a1, A1_a2);
L1Ah1 = bq(st, 10, L1Ah1, A1_n, -2 * A1_n, A1_n, A1_a1, A1_a2);
L1Alm = bq(st, 12, L1Ah1, A2_lb, 2 * A2_lb, A2_lb, A2_a1, A2_a2);
L1Alm = bq(st, 14, L1Alm, A2_lb, 2 * A2_lb, A2_lb, A2_a1, A2_a2);
L1Alm = bq(st, 16, L1Alm, A3_a2, A3_a1, 1, A3_a1, A3_a2);
L1Ah2 = bq(st, 18, L1Ah1, A2_n, -2 * A2_n, A2_n, A2_a1, A2_a2);
L1Ah2 = bq(st, 20, L1Ah2, A2_n, -2 * A2_n, A2_n, A2_a1, A2_a2);
L1Amh = bq(st, 22, L1Ah2, A3_lb, 2 * A3_lb, A3_lb, A3_a1, A3_a2);
L1Amh = bq(st, 24, L1Amh, A3_lb, 2 * A3_lb, A3_lb, A3_a1, A3_a2);
L1Ahi = bq(st, 26, L1Ah2, A3_n, -2 * A3_n, A3_n, A3_a1, A3_a2);
L1Ahi = bq(st, 28, L1Ahi, A3_n, -2 * A3_n, A3_n, A3_a1, A3_a2);
L1A = g_low * L1Al + g_lowmid * L1Alm + g_midhigh * L1Amh + g_high * L1Ahi;
L1Cl = bq(st, 30, L_u1, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L1Cl = bq(st, 32, L1Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
L1Cl = bq(st, 34, L1Cl, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L1Ch1 = bq(st, 36, L_u1, C1_n, -2 * C1_n, C1_n, C1_a1, C1_a2);
L1Ch1 = -L1Ch1;
L1Clm = bq(st, 38, L1Ch1, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L1Clm = bq(st, 40, L1Clm, C2_lb, 2 * C2_lb, C2_lb, C2_a1, C2_a2);
L1Clm = bq(st, 42, L1Clm, C3_a2, C3_a1, 1, C3_a1, C3_a2);
L1Ch2 = bq(st, 44, L1Ch1, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L1Ch2 = bq(st, 46, L1Ch2, C2_n, -2 * C2_n, C2_n, C2_a1, C2_a2);
L1Cmh = bq(st, 48, L1Ch2, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L1Cmh = bq(st, 50, L1Cmh, C3_lb, 2 * C3_lb, C3_lb, C3_a1, C3_a2);
L1Chi = bq(st, 52, L1Ch2, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L1Chi = bq(st, 54, L1Chi, C3_n, -2 * C3_n, C3_n, C3_a1, C3_a2);
L1C = g_low * L1Cl + g_lowmid * L1Clm + g_midhigh * L1Cmh + g_high * L1Chi;
L1Dl = bq(st, 56, L_u1, D1_lb, 2 * D1_lb, D1_lb, D1_a1, D1_a2);
L1Dl = bq(st, 58, L1Dl, D2_a2, D2_a1, 1, D2_a1, D2_a2);
L1Dl = bq(st, 60, L1Dl, D3_a2, D3_a1, 1, D3_a1, D3_a2);
L1Dh1 = bq(st, 62, L_u1, D1_n, -2 * D1_n, D1_n, D1_a1, D1_a2);
L1Dh1 = -L1Dh1;
L1Dlm = bq(st, 64, L1Dh1, D2_lb, 2 * D2_lb, D2_lb, D2_a1, D2_a2);
L1Dlm = bq(st, 66, L1Dlm, D2_lb, 2 * D2_lb, D2_lb, D2_a1, D2_a2);
L1Dlm = bq(st, 68, L1Dlm, D3_a2, D3_a1, 1, D3_a1, D3_a2);
L1Dh2 = bq(st, 70, L1Dh1, D2_n, -2 * D2_n, D2_n, D2_a1, D2_a2);
L1Dh2 = bq(st, 72, L1Dh2, D2_n, -2 * D2_n, D2_n, D2_a1, D2_a2);
L1Dmh = bq(st, 74, L1Dh2, D3_lb, 2 * D3_lb, D3_lb, D3_a1, D3_a2);
L1Dmh = bq(st, 76, L1Dmh, D3_lb, 2 * D3_lb, D3_lb, D3_a1, D3_a2);
L1Dhi = bq(st, 78, L1Dh2, D3_n, -2 * D3_n, D3_n, D3_a1, D3_a2);
L1Dhi = bq(st, 80, L1Dhi, D3_n, -2 * D3_n, D3_n, D3_a1, D3_a2);
L1D = g_low * L1Dl + g_lowmid * L1Dlm + g_midhigh * L1Dmh + g_high * L1Dhi;
L_y1 = max(0, 1 - abs(s_x - 0)) * L1A + max(0, 1 - abs(s_x - 1)) * L1C + max(0, 1 - abs(s_x - 2)) * L1D;
L2Al = bq(st, 0, L_u2, A1_lb, 2 * A1_lb, A1_lb, A1_a1, A1_a2);
L2Al = bq(st, 2, L2Al, A1_lb, 2 * A1_lb, A1_lb, A1_a1, A1_a2);
L2Al = bq(st, 4, L2Al, A2_a2, A2_a1, 1, A2_a1, A2_a2);
L2Al = bq(st, 6, L2Al, A3_a2, A3_a1, 1, A3_a1, A3_a2);
L2Ah1 = bq(st, 8, L_u2, A1_n, -2 * A1_n, A1_n, A1_a1, A1_a2);
L2Ah1 = bq(st, 10, L2Ah1, A1_n, -2 * A1_n, A1_n, A1_a1, A1_a2);
L2Alm = bq(st, 12, L2Ah1, A2_lb, 2 * A2_lb, A2_lb, A2_a1, A2_a2);
L2Alm = bq(st, 14, L2Alm, A2_lb, 2 * A2_lb, A2_lb, A2_a1, A2_a2);
L2Alm = bq(st, 16, L2Alm, A3_a2, A3_a1, 1, A3_a1, A3_a2);
L2Ah2 = bq(st, 18, L2Ah1, A2_n, -2 * A2_n, A2_n, A2_a1, A2_a2);
L2Ah2 = bq(st, 20, L2Ah2, A2_n, -2 * A2_n, A2_n, A2_a1, A2_a2);
L2Amh = bq(st, 22, L2Ah2, A3_lb, 2 * A3_lb, A3_lb, A3_a1, A3_a2);
L2Amh = bq(st, 24, L2Amh, A3_lb, 2 * A3_lb, A3_lb, A3_a1, A3_a2);
L2Ahi = bq(st, 26, L2Ah2, A3_n, -2 * A3_n, A3_n, A3_a1, A3_a2);
L2Ahi = bq(st, 28, L2Ahi, A3_n, -2 * A3_n, A3_n, A3_a1, A3_a2);
L2A = g_low * L2Al + g_lowmid * L2Alm + g_midhigh * L2Amh + g_high * L2Ahi;
L2Cl = bq(st, 30, L_u2, C1_lb, 2 * C1_lb, C1_lb, C1_a1, C1_a2);
L2Cl = bq(st, 32, L2Cl, C2_a2, C2_a1, 1, C2_a1, C2_a2);
