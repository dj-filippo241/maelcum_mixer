// MC-SEND - prototipo Max P3 (FX-SEND, fx-send-module §2).
// GENERATO da proto-max/coefficienti/genera_fx.py: non modificare.
// L'audio del canale passa intatto (out1, out2). EQ2 -> LEVEL ->
// 4 ASSIGN (rampa 1 ms) -> out3..out10 = bus 1-4, L e R.

// allpass del 1o ordine del halfband; stato in m[i] (x), m[i+1] (y)
ap(m, i, x, c) {
	y = c * (x - peek(m, i + 1)) + peek(m, i);
	poke(m, x, i);
	poke(m, y, i + 1);
	return y;
}

// polo singolo TPT, uscita passa-basso; stato in m[i]
op1(m, i, x, g) {
	s = peek(m, i);
	v = (x - s) * g / (1 + g);
	lo = v + s;
	poke(m, lo + v, i);
	return lo;
}

// SVF 2 poli TPT, uscita passa-alto; stato in m[i], m[i+1]; k = 1/Q
svhp(m, i, x, g, k) {
	s1 = peek(m, i);
	s2 = peek(m, i + 1);
	fh = (x - (k + g) * s1 - s2) / (1 + g * (k + g));
	fb = g * fh + s1;
	fl = g * fb + s2;
	poke(m, g * fh + fb, i);
	poke(m, g * fb + fl, i + 1);
	return fh;
}

Param low(50, min=0, max=100);
Param high(50, min=0, max=100);
Param level(0, min=0, max=100);
Param as1(0, min=0, max=1);
History r_as1(0);
Param as2(0, min=0, max=1);
History r_as2(0);
Param as3(0, min=0, max=1);
History r_as3(0);
Param as4(0, min=0, max=1);
History r_as4(0);
Data sv(4);
Data sa(4);
Data hb(128);
History s_low(50);
History s_high(50);
History s_level(0);
t10 = exp(-1 / (0.010 * samplerate));
s_low = low + t10 * (s_low - low);
s_high = high + t10 * (s_high - high);
s_level = level + t10 * (s_level - level);
sr4 = samplerate * 4;
// EQ2 LOW: dB voluti -> posizione x del pot (fx.low_x)
ldb = (s_low / 100 >= 0.5) * 12.0 * (s_low / 100 - 0.5) + (s_low / 100 < 0.5) * ((s_low / 100 < 0.2) * (-30.0 + 120.0 * (s_low / 100 - 0.0)) + (s_low / 100 >= 0.2) * (-6.0 + 20.0 * (s_low / 100 - 0.2)));
lgl = pow(10, ldb / 20);
lx = (32.0 - lgl) / (31.0 * (lgl + 1));
// EQ2 HIGH: posizione thh del pot (fx.high_thh)
hth = (s_high / 100 >= 0.5) * 0.5 * pow(10, 0.6 * (s_high / 100 - 0.5)) + (s_high / 100 < 0.5) * (s_high / 100 >= 0.3) * 0.5 * pow(10, -3.75 * (0.5 - s_high / 100)) + (s_high / 100 < 0.3) * 0.2963799016731538 * s_high / 100;
lra = 31000.0 * lx + 0.001;
lrb = 31000.0 * (1 - lx) + 0.001;
ala = 1000.0 / (1000.0 + lrb);
gla = 1 / (2 * sr4 * lrb * 5.6e-08);
alb = (1000.0 + lra) / 1000.0;
glb = (1000.0 + lra) / (2 * sr4 * 1000.0 * lra * 5.6e-08);
lgk = (1000.0 + lrb) / (1000.0 + lra);
hr1 = 10000.0 * hth + 0.001;
hr2 = 10000.0 * (1 - hth) + 0.001;
hk = (1 / hr2 - 1 / hr1) / (1 / hr1 + 1 / hr2 + 2.004008016032064e-05);
ghp = tan(13827.674747047453 / sr4);
khp = 2.892749557082327;
tv = s_level / 100;
lev = (tv <= 0.5) * 0.2 * tv + (tv > 0.5) * (0.1 + 1.8 * (tv - 0.5));
pr = 1 / (0.001 * samplerate);
r_as1 = r_as1 + min(max(as1 - r_as1, -pr), pr);
r_as2 = r_as2 + min(max(as2 - r_as2, -pr), pr);
r_as3 = r_as3 + min(max(as3 - r_as3, -pr), pr);
r_as4 = r_as4 + min(max(as4 - r_as4, -pr), pr);
// ===== lato L =====
L_e = in1;
L_o = in1;
L_e = ap(hb, 0, L_e, 0.019059005558478156);
L_e = ap(hb, 4, L_e, 0.1559582483500435);
L_e = ap(hb, 8, L_e, 0.3650536901969154);
L_e = ap(hb, 12, L_e, 0.5755010797915323);
